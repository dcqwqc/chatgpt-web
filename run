#!/bin/sh
set -eu

# Resolve linked launchers with POSIX readlink (GNU readlink -f is not portable).
script_path=$0
link_count=0
while [ -L "$script_path" ]; do
    link_count=$((link_count + 1))
    if [ "$link_count" -gt 20 ]; then
        echo 'chatgpt-web: too many launcher symlinks' >&2
        exit 1
    fi
    script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)
    target=$(readlink "$script_path")
    case "$target" in
        /*) script_path=$target ;;
        *) script_path=$script_dir/$target ;;
    esac
done
script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd)
data_root=${XDG_DATA_HOME:-"$HOME/.local/share"}
venv_python="$data_root/chatgpt-web/venv/bin/python"

if command -v uv >/dev/null 2>&1; then
    exec uv run --script "$script_dir/chatgpt-web" "$@"
fi

if [ -x "$venv_python" ]; then
    exec "$venv_python" "$script_dir/chatgpt-web" "$@"
fi

exec python3 "$script_dir/chatgpt-web" "$@"
