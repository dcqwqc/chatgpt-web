DEFAULT_CDP_URL = "http://127.0.0.1:9222"
# Pin Chrome CDP helpers to a verified Node runtime with WebSocket support.
NODE_BINARY = os.environ.get("CHATGPT_WEB_NODE_BINARY", "/usr/bin/node")
DEFAULT_PAGE_SIZE = 28
CHATGPT_ORIGIN = "https://chatgpt.com"
MAX_DAEMON_MESSAGE = 64 * 1024 * 1024
FORBIDDEN_REPLAY_HEADERS = {
    "host", "content-length", "connection", ":authority", ":method",
    ":path", ":scheme", "x-openai-target-path", "x-openai-target-route",
}


class ChatGPTWebError(RuntimeError):
    pass


class SentinelCompatibilityError(ChatGPTWebError):
    pass


def default_socket_path() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    base = Path(runtime) if runtime else Path("/tmp") / f"chatgpt-web-{os.getuid()}"
    # Versioned socket lets upgraded clients start a new backend safely
    # without killing an older daemon that may still be serving a live turn.
    return base / "chatgpt-web" / "daemon-v4.sock" if runtime else base / "daemon-v4.sock"


def auth_store_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    root = Path(state_home) if state_home else Path.home() / ".local" / "state"
    return root / "chatgpt-web" / "session.json"


def conversation_cache_dir() -> Path:
    data_home = os.environ.get("XDG_DATA_HOME")
    root = Path(data_home) if data_home else Path.home() / ".local" / "share"
    return root / "chatgpt-web" / "conversations"


def conversation_cache_path(conversation_id: str) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9_-]+", conversation_id):
        raise ChatGPTWebError("invalid conversation ID")
    return conversation_cache_dir() / f"{conversation_id}.json"


def active_conversation_path() -> Path:
    return conversation_cache_dir().parent / "active-conversation.json"


def atomic_json_write(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, tmp = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent,
    )
    temporary = Path(tmp)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def set_active_conversation(conversation_id: str | None) -> None:
    if conversation_id is None:
        active_conversation_path().unlink(missing_ok=True)
        return
    conversation_cache_path(conversation_id)
    atomic_json_write(active_conversation_path(), {"conversation_id": conversation_id})


def cache_conversation(conversation: dict[str, Any], make_active: bool = True) -> dict[str, Any]:
    raw_messages = conversation.get("messages")
    already_normalized = (
        isinstance(raw_messages, list)
        and (not raw_messages or (
            isinstance(raw_messages[0], dict)
            and "role" in raw_messages[0]
            and "author" not in raw_messages[0]
        ))
    )
    normalized = dict(conversation) if already_normalized else normalize_conversation(conversation)
    conversation_id = normalized.get("id")
    if not isinstance(conversation_id, str) or not conversation_id:
        raise ChatGPTWebError("conversation has no ID")
    normalized["cached_at"] = time.time()
    atomic_json_write(conversation_cache_path(conversation_id), normalized)
    if make_active:
        set_active_conversation(conversation_id)
    return normalized


def load_cached_conversation(conversation_id: str | None = None, *, allow_external: bool = False) -> dict[str, Any] | None:
    if conversation_id is None:
        try:
            active = json.loads(active_conversation_path().read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return None
        candidate = active.get("conversation_id") if isinstance(active, dict) else None
        if not isinstance(candidate, str) or not candidate:
            return None
        conversation_id = candidate
    try:
        value = json.loads(conversation_cache_path(conversation_id).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict):
        return None
    selected_project = load_preferences().get("project_id")
    if not allow_external and (not PROJECT_ID_RE.fullmatch(str(selected_project)) or
            value.get("gizmo_id") != selected_project):
        return None
    return value


def rename_cached_conversation(conversation_id: str, title: str) -> None:
    cached = load_cached_conversation(conversation_id)
    if cached is None:
        return
    cached["title"] = title
    atomic_json_write(conversation_cache_path(conversation_id), cached)


def sentinel_cache_status() -> dict[str, Any] | None:
    cache_home = os.environ.get("XDG_CACHE_HOME")
    root = Path(cache_home) if cache_home else Path.home() / ".cache"
    manifest = root / "chatgpt-web" / "sentinel" / "current.json"
    try:
        value = json.loads(manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    digest = value.get("sha256")
    implementation = value.get("implementation")
    checked_at = value.get("checked_at")
    if not isinstance(digest, str) or not isinstance(implementation, str):
        return None
    return {
        "implementation": implementation,
        "sha256": digest,
        "checked_at": checked_at if isinstance(checked_at, int) else None,
    }


def save_auth_snapshot(url: str, headers: dict[str, str]) -> None:
    path = auth_store_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    descriptor, tmp = tempfile.mkstemp(
        prefix=".session-", suffix=".tmp", dir=path.parent,
    )
    temporary = Path(tmp)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump({"version": 1, "url": url, "headers": headers}, stream)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        if temporary.exists():
            temporary.unlink()


def load_auth_snapshot() -> tuple[str, dict[str, str]]:
    path = auth_store_path()
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        url = value["url"]
        headers = value["headers"]
    except FileNotFoundError as error:
        raise ChatGPTWebError("no saved session; run chatgpt-web login") from error
    except (KeyError, TypeError, json.JSONDecodeError, OSError) as error:
        raise ChatGPTWebError("saved ChatGPT session is invalid") from error
    parsed = urlsplit(url)
    if parsed.scheme != "https" or parsed.netloc != "chatgpt.com":
        raise ChatGPTWebError("saved ChatGPT session has an invalid origin")
    if not isinstance(headers, dict) or not all(
        isinstance(key, str) and isinstance(item, str)
        for key, item in headers.items()
    ):
        raise ChatGPTWebError("saved ChatGPT session has invalid headers")
    return url, {key.lower(): value for key, value in headers.items()}


def capture_auth(cdp_url: str) -> tuple[str, dict[str, str]]:
    helper = Path(__file__).with_name("chrome-auth.js")
    environment = os.environ.copy()
    environment["CHATGPT_WEB_CDP_URL"] = cdp_url.rstrip("/")
    try:
        result = subprocess.run(
            [NODE_BINARY, str(helper)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=20,
            check=False,
            env=environment,
        )
    except FileNotFoundError as error:
        raise ChatGPTWebError("Node.js 22 or newer is required for Chrome authentication") from error
    except subprocess.TimeoutExpired as error:
        raise ChatGPTWebError("Chrome authentication capture timed out") from error

    if result.returncode != 0:
        detail = result.stderr.strip() or "Chrome authentication capture failed"
        raise ChatGPTWebError(detail)
    try:
        captured = json.loads(result.stdout)
        captured_url = captured["url"]
        origin = urlsplit(captured_url)
        if (origin.scheme != "https" or origin.netloc != "chatgpt.com"
                or not origin.path.startswith("/backend-api/")):
            raise ChatGPTWebError("Chrome auth capture had an invalid origin")
        url = urljoin(CHATGPT_ORIGIN, "/backend-api/conversations")
        headers = {
            key.lower(): value for key, value in captured["headers"].items()
            if key.lower() not in FORBIDDEN_REPLAY_HEADERS
        }
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        raise ChatGPTWebError("Chrome returned an invalid authentication snapshot") from error
    return url, headers


class ChatGPTWebClient:
    def __init__(self, cdp_url: str) -> None:
        self.cdp_url = cdp_url
        self.list_url = ""
        self.headers: dict[str, str] = {}
        self.http = httpx.Client(
            follow_redirects=False,
            timeout=httpx.Timeout(30.0),
        )
        self.refresh_auth(prefer_browser=True)

    def close(self) -> None:
        self.http.close()

    def __enter__(self) -> "ChatGPTWebClient":
        return self

    def __exit__(self, *_args: object) -> None:
        self.close()

    def refresh_auth(self, prefer_browser: bool = False) -> None:
        if prefer_browser and chrome_is_ready(self.cdp_url):
            self.list_url, self.headers = capture_auth(self.cdp_url)
            save_auth_snapshot(self.list_url, self.headers)
            return
        try:
            self.list_url, self.headers = load_auth_snapshot()
        except ChatGPTWebError:
            if not chrome_is_ready(self.cdp_url):
                raise
            self.list_url, self.headers = capture_auth(self.cdp_url)
            save_auth_snapshot(self.list_url, self.headers)

    def refresh_session(self) -> None:
        headers = self.headers.copy()
        headers.pop("authorization", None)
        response = self.http.get(
            urljoin(CHATGPT_ORIGIN, "/api/auth/session"),
            headers=headers,
            timeout=30,
        )
        if response.status_code != 200:
            raise ChatGPTWebError(
                "saved session expired; run chatgpt-web login"
            )
        try:
            value = response.json()
            token = value.get("accessToken")
        except (ValueError, AttributeError) as error:
            raise ChatGPTWebError("ChatGPT session refresh returned invalid data") from error
        if not isinstance(token, str) or not token:
            raise ChatGPTWebError("saved session expired; run chatgpt-web login")
        self.headers["authorization"] = f"Bearer {token}"
        cookie_header = self.headers.get("cookie", "")
        cookies = SimpleCookie()
        cookies.load(cookie_header)
        for cookie in response.cookies.jar:
            cookies[cookie.name] = cookie.value
        self.headers["cookie"] = "; ".join(
            f"{name}={morsel.value}" for name, morsel in cookies.items()
        )
        save_auth_snapshot(self.list_url, self.headers)

    def request(self, method: str, url: str, **kwargs: Any) -> httpx.Response:
        for attempt in range(2):
            request_headers = self.headers.copy()
            # httpx only decodes Brotli and Zstandard when optional packages are
            # installed. Ask for encodings available in the minimal uv setup.
            request_headers["accept-encoding"] = "gzip, deflate"
            target_path = urlsplit(url).path
            request_headers["x-openai-target-path"] = target_path
            request_headers["x-openai-target-route"] = target_path
            # Retrying reads is safe; retrying a submission is not. A timed-out
            # POST may have been accepted and must never be sent twice blindly.
            read_attempts = 3 if method.upper() == "GET" else 1
            for read_attempt in range(read_attempts):
                try:
                    response = self.http.request(
                        method, url, headers=request_headers, **kwargs
                    )
                    break
                except (httpx.ReadTimeout, httpx.ConnectTimeout) as error:
                    if read_attempt + 1 >= read_attempts:
                        if method.upper() == "GET":
                            raise ChatGPTWebError(
                                f"ChatGPT GET {target_path} timed out after "
                                f"{read_attempts} read attempts"
                            ) from error
                        raise
                    time.sleep(0.5 * (2 ** read_attempt))
            if response.status_code not in (401, 403) or attempt == 1:
                break
            try:
                self.refresh_session()
            except ChatGPTWebError:
                if not chrome_is_ready(self.cdp_url):
                    raise
                self.list_url, self.headers = capture_auth(self.cdp_url)
                save_auth_snapshot(self.list_url, self.headers)
        if response.status_code == 429:
            retry_after = response.headers.get("retry-after")
            suffix = f"; retry after {retry_after} seconds" if retry_after else ""
            raise ChatGPTWebError(f"ChatGPT web rate limit reached{suffix}")
        if response.status_code >= 400:
            raise ChatGPTWebError(
                f"ChatGPT returned HTTP {response.status_code} for {method} {response.url.path}"
            )
        content_type = response.headers.get("content-type", "")
        if "application/json" not in content_type:
            raise ChatGPTWebError(
                f"ChatGPT returned unexpected content type {content_type or '<missing>'}"
            )
        return response

    def verify(self) -> dict[str, Any]:
        return self.request("GET", self.list_url).json()

    def target_project_id(self) -> str:
        """Resolve the exact CLI Project; refuse ambiguous or missing projects."""
        pinned = load_preferences().get("project_id")
        saved = getattr(self, "_cli_project_cache", None)
        if saved is not None and saved[1] > time.monotonic() and (
            pinned is None or pinned == saved[0]
        ):
            return saved[0]
        projects = []
        cursor = None
        seen_cursors = set()
        for _ in range(30):
            params = {"owned_only": "true", "conversations_per_gizmo": 0}
            if cursor:
                params["cursor"] = cursor
            response = self.request(
                "GET", urljoin(CHATGPT_ORIGIN, "/backend-api/gizmos/snorlax/sidebar"),
                params=params,
            ).json()
            try:
                projects.extend(parse_projects(response))
            except ValueError as error:
                raise ChatGPTWebError(str(error)) from error
            cursor = response.get("cursor")
            if not cursor:
                break
            if not isinstance(cursor, str) or cursor in seen_cursors:
                raise ChatGPTWebError("ChatGPT Project pagination returned invalid or repeated cursor")
            seen_cursors.add(cursor)
        else:
            raise ChatGPTWebError("ChatGPT Project listing exceeded 30 pages")
        if len(projects) != 1:
            raise ChatGPTWebError(
                f'Expected exactly one ChatGPT Project named "{PROJECT_NAME}", '
                f'found {len(projects)}. New chats are blocked to avoid clutter.'
            )
        project_id = projects[0]["id"]
        pinned = load_preferences().get("project_id")
        if pinned is not None and pinned != project_id:
            raise ChatGPTWebError("Configured CLI Project differs from the account's Project; refusing to send")
        if pinned is None:
            save_preferences(project_id=project_id)
        self._cli_project_cache = (project_id, time.monotonic() + 300)
        return project_id

    def available_models(self) -> list[dict[str, str]]:
        try:
            models = parse_models(self.request(
                "GET", urljoin(CHATGPT_ORIGIN, "/backend-api/models"),
            ).json())
        except ValueError as error:
            raise ChatGPTWebError(str(error)) from error
        if not models:
            raise ChatGPTWebError("No selectable ChatGPT models were reported")
        return models

    def model_capabilities(self) -> list[dict[str, Any]]:
        """Account-reported per-model thinking capabilities for BB.

        The website's standard/extended vocabulary is represented as
        Medium/High in BB; do not offer unsupported Extra High levels.
        """
        payload = self.request(
            "GET", urljoin(CHATGPT_ORIGIN, "/backend-api/models"),
        ).json()
        allowed = {model["slug"] for model in parse_models(payload)}
        result = []
        for raw in payload.get("models", []):
            if not isinstance(raw, dict):
                continue
            slug = raw.get("slug")
            if slug not in allowed:
                continue
            reasoning_type = raw.get("reasoning_type")
            if reasoning_type not in ("none", "auto", "reasoning"):
                reasoning_type = "auto"
            efforts = []
            if raw.get("configurable_thinking_effort") is True:
                for effort in raw.get("thinking_efforts", []):
                    if not isinstance(effort, dict):
                        continue
                    name = effort.get("thinking_effort")
                    if name in ("standard", "extended"):
                        value = "medium" if name == "standard" else "high"
                        if value not in [e["value"] for e in efforts]:
                            efforts.append({
                                "value": value, "name": value.title(),
                                "thinking_effort": name,
                            })
            result.append({
                "slug": slug, "title": str(raw.get("title") or slug)[:80],
                "reasoning_type": reasoning_type,
                "efforts": efforts,
            })
        return result

    def model_status(self) -> dict[str, Any]:
        models = self.available_models()
        selected = load_preferences().get("model")
        if selected is not None and selected not in {row["slug"] for row in models}:
            raise ChatGPTWebError("Saved model is no longer selectable; run /model to choose another")
        default = "gpt-6" if any(row["slug"] == "gpt-6" for row in models) else models[0]["slug"]
        return {"selected": selected or default, "models": models}

    def set_model(self, slug: str) -> dict[str, Any]:
        if not MODEL_RE.fullmatch(slug):
            raise ChatGPTWebError("Invalid model identifier")
        models = self.available_models()
        matched = next((item for item in models if item["slug"] == slug), None)
        if matched is None:
            raise ChatGPTWebError("Model isn't currently listed as selectable on your account")
        save_preferences(model=slug)
        return {"selected": slug, "title": matched["title"]}

    def list_project_conversations(
        self, maximum: int | None = 50, *, max_pages: int | None = None,
        page_timeout: float | None = None,
    ) -> list[dict[str, Any]]:
        # A verified, pinned Project ID is sufficient for read-only listings.
        # Sending still calls target_project_id() and verifies Project ownership.
        pinned = load_preferences().get("project_id")
        project_id = (pinned if max_pages is not None
                      and isinstance(pinned, str) and PROJECT_ID_RE.fullmatch(pinned)
                      else self.target_project_id())
        rows: list[dict[str, Any]] = []
        cursor = "0"
        visited = set()
        while cursor and cursor not in visited:
            if max_pages is not None and len(visited) >= max_pages:
                break
            visited.add(cursor)
            response = self.request(
                "GET", urljoin(CHATGPT_ORIGIN, f"/backend-api/gizmos/{project_id}/conversations"),
                params={"cursor": cursor},
                **({"timeout": page_timeout} if page_timeout is not None else {}),
            ).json()
            if not isinstance(response, dict) or not isinstance(response.get("items"), list):
                raise ChatGPTWebError("ChatGPT Project conversation listing is invalid")
            for row in response["items"]:
                if isinstance(row, dict) and row.get("gizmo_id") == project_id:
                    rows.append(row)
            if maximum is not None and len(rows) >= maximum:
                return rows[:maximum]
            next_cursor = response.get("cursor")
            cursor = next_cursor if isinstance(next_cursor, str) and next_cursor else ""
        return rows

    def usage_status(self) -> dict[str, Any]:
        """Only expose ordinary-chat usage data, never Codex rates mislabeled as Web."""
        value = web_usage_status()
        value["selected_model"] = load_preferences().get("model") or "gpt-6"
        value["project"] = PROJECT_NAME
        try:
            report = self.request("GET", urljoin(CHATGPT_ORIGIN, "/backend-api/wham/usage")).json()
            value["codex"] = summarize_codex_usage(report)
        except (ChatGPTWebError, httpx.HTTPError, ValueError) as error:
            value["codex"] = {"available": False, "error": str(error)}
        return value

    def list_conversations(self, maximum: int | None) -> list[dict[str, Any]]:
        offset = 0
        conversations: list[dict[str, Any]] = []
        seen: set[str] = set()
        while True:
            response = self.request(
                "GET",
                urljoin(CHATGPT_ORIGIN, "/backend-api/conversations"),
                params={
                    "offset": offset,
                    "limit": DEFAULT_PAGE_SIZE,
                    "order": "updated",
                    "is_archived": "false",
                    "is_starred": "false",
                },
            ).json()
            items = response.get("items", [])
            if not isinstance(items, list):
                raise ChatGPTWebError("conversation list did not contain an items array")
            fresh = [
                item for item in items
                if isinstance(item, dict) and item.get("id") not in seen
            ]
            conversations.extend(fresh)
            seen.update(item["id"] for item in fresh if item.get("id"))
            offset += len(items)
            if maximum is not None and len(conversations) >= maximum:
                return conversations[:maximum]
            # The private endpoint's `total` is a rolling window marker rather
            # than a stable collection size. A short page (or no new IDs) is
            # the reliable end condition.
            if len(items) < DEFAULT_PAGE_SIZE or not fresh:
                return conversations

    def get_conversation(self, conversation_id: str) -> dict[str, Any]:
        url = urljoin(
            CHATGPT_ORIGIN,
            f"/backend-api/conversations/{conversation_id}",
        )
        result = self.request("GET", url).json()
        if not isinstance(result, dict):
            raise ChatGPTWebError("conversation response was not an object")
        return result

    def rename_conversation(self, conversation_id: str, title: str) -> None:
        self.request(
            "PATCH",
            urljoin(CHATGPT_ORIGIN, f"/backend-api/conversation/{conversation_id}"),
            json={"title": title},
        )

    def send_prompt(
        self,
        conversation_id: str | None,
        prompt: str,
        attachments: list[dict[str, Any]] | None = None,
        on_event: Any = None,
        *,
        allow_existing_outside_project: bool = False,
    ) -> tuple[str, dict[str, Any], set[str]]:
        if attachments and os.environ.get("CHATGPT_WEB_SEND_MODE", "node") != "node":
            raise ChatGPTWebError("image attachments require the direct node send mode")
        if os.environ.get("CHATGPT_WEB_SEND_MODE", "node") == "chrome":
            raise ChatGPTWebError("Browser send mode cannot guarantee CLI Project routing; use the default direct mode")
        if on_event:
            on_event({"type":"phase", "status":"Checking CLI Project…"})
        project_id = self.target_project_id()
        previous_ids: set[str] = set()
        previous: dict[str, Any] | None = None
        if conversation_id:
            previous = self.get_conversation(conversation_id)
            if previous.get("gizmo_id") != project_id and not allow_existing_outside_project:
                raise ChatGPTWebError(
                    "This conversation is outside the CLI Project. "
                    "Continue it in the interactive TUI, or /new to start a CLI Project chat."
                )
            previous_messages = previous.get("messages", [])
            if isinstance(previous_messages, list):
                previous_ids = {
                    item["id"] for item in previous_messages
                    if isinstance(item, dict) and item.get("id")
                }

        if os.environ.get("CHATGPT_WEB_SEND_MODE", "node") != "chrome":
            resolved_id, submitted_message_id = self.send_prompt_direct(
                previous, prompt, attachments or [], on_event
            )
            if on_event:
                on_event({"type":"phase", "status":"Verifying saved conversation…"})
            conversation = self.get_conversation(resolved_id)
            # Project-only scripted requests stay isolated; interactive continuations
            # must remain in their original chat and original Project (if any).
            expected_project = previous.get("gizmo_id") if previous is not None else project_id
            if (conversation.get("gizmo_id") != expected_project
                    or (conversation_id is not None and resolved_id != conversation_id)):
                if conversation_id is None:
                    # Only delete the new, incorrectly routed chat created by this request.
                    try:
                        self.request(
                            "DELETE",
                            urljoin(CHATGPT_ORIGIN, f"/backend-api/conversation/{resolved_id}"),
                        )
                    except (ChatGPTWebError, httpx.HTTPError):
                        pass
                raise ChatGPTWebError(
                    "ChatGPT did not preserve the requested conversation/Project; "
                    "response blocked. A misrouted new conversation was cleaned up "
                    "when possible; existing chats were not deleted."
                )
            messages = conversation.get("messages", [])
            attached = isinstance(messages, list) and any(
                isinstance(message, dict) and message.get("id") == submitted_message_id
                for message in messages
            )
            if not attached:
                raise ChatGPTWebError(
                    "ChatGPT did not attach the submitted message to the conversation"
                )
            return resolved_id, conversation, previous_ids

        helper = Path(__file__).with_name("chrome-send.js")
        environment = os.environ.copy()
        environment["CHATGPT_WEB_CDP_URL"] = self.cdp_url.rstrip("/")
        process = None
        try:
            process = subprocess.Popen(
                [NODE_BINARY, str(helper)],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
                env=environment,
            )
            assert process.stdin is not None
            assert process.stdout is not None
            process.stdin.write(json.dumps({
                "conversation_id": conversation_id,
                "prompt": prompt,
            }))
            process.stdin.close()
            resolved_id = None
            for line in process.stdout:
                try:
                    event = json.loads(line)
                except json.JSONDecodeError as error:
                    raise ChatGPTWebError(
                        "Chrome returned an invalid stream event"
                    ) from error
                if event.get("type") == "completed":
                    resolved_id = event.get("conversation_id")
                elif on_event is not None:
                    on_event(event)
            return_code = process.wait(timeout=5)
        except (BrokenPipeError, ConnectionError, OSError):
            if process is not None and process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    process.kill()
            raise
        except subprocess.TimeoutExpired as error:
            if process is not None:
                process.kill()
            raise ChatGPTWebError("prompt submission timed out") from error
        if return_code != 0:
            assert process.stderr is not None
            detail = process.stderr.read().strip() or "prompt submission failed"
            raise ChatGPTWebError(detail)
        if not isinstance(resolved_id, str) or not resolved_id:
            raise ChatGPTWebError("ChatGPT did not return a conversation ID")

        conversation = self.get_conversation(resolved_id)
        return resolved_id, conversation, previous_ids

    def send_prompt_direct(
        self,
        conversation: dict[str, Any] | None,
        prompt: str,
        attachments: list[dict[str, Any]],
        on_event: Any = None,
    ) -> tuple[str, str]:
        conversation_id = None
        if conversation:
            candidate = conversation.get("conversation_id") or conversation.get("id")
            if isinstance(candidate, str):
                conversation_id = candidate
        mode = os.environ.get("CHATGPT_WEB_SEND_MODE", "node")
        if mode == "recipe":
            method, url, headers, body = self.capture_send_recipe(
                conversation_id, prompt
            )
        else:
            try:
                sentinel_headers = self.create_sentinel_headers(
                    on_phase=(lambda label: on_event({"type":"phase","status":label}))
                    if on_event else None
                )
            except SentinelCompatibilityError as error:
                if not chrome_is_ready(self.cdp_url):
                    raise ChatGPTWebError(
                        f"{error}; run chatgpt-web login for compatibility fallback"
                    ) from error
                if chrome_needs_interactive_verification(self.cdp_url):
                    raise ChatGPTWebError(
                        "ChatGPT's verification requirements changed and the "
                        "authenticated Chrome tab is showing an interactive security "
                        "challenge. Open the existing Philipedia Chrome login window "
                        "to complete verification; no prompt was submitted."
                    ) from error
                method, url, headers, body = self.capture_send_recipe(
                    conversation_id, prompt
                )
            else:
                method = "POST"
                url = urljoin(CHATGPT_ORIGIN, "/backend-api/f/conversation")
                headers = self.headers.copy()
                headers.update(sentinel_headers)
                body = self.create_conversation_body(
                    conversation, prompt, attachments
                )

        # Preserve the server-verified owner and never let a browser recipe
        # silently move a conversation into a different Project.
        owner = conversation.get("gizmo_id") if conversation is not None else self.target_project_id()
        for key in ("gizmo_id", "conversation_template_id"):
            body.pop(key, None)
        if isinstance(owner, str) and owner:
            body["conversation_mode"] = {"kind": "gizmo_interaction", "gizmo_id": owner}
            body["gizmo_id"] = owner
            body["conversation_template_id"] = owner
        else:
            body["conversation_mode"] = {"kind": "primary_assistant"}
        # ACP model selection is per request, not the shared CLI preference.
        if getattr(self, "_request_model", None):
            body["model"] = self._request_model
        if getattr(self, "_request_thinking_effort", None):
            body["thinking_effort"] = self._request_thinking_effort
        headers.pop("x-openai-web-sse-compression", None)
        headers["x-openai-target-path"] = "/backend-api/f/conversation"
        headers["x-openai-target-route"] = "/backend-api/f/conversation"
        body["supported_encodings"] = []
        body["supports_buffering"] = False
        submitted_message_id = body.get("messages", [{}])[0].get("id")
        if not isinstance(submitted_message_id, str) or not submitted_message_id:
            raise ChatGPTWebError("conversation request has no user message ID")
        resolved_id: str | None = conversation_id
        rendered = ""
        if on_event:
            on_event({"type":"phase","status":"Submitting request to ChatGPT…"})
        with self.http.stream(
            method,
            url,
            headers=headers,
            json=body,
            timeout=httpx.Timeout(300.0),
        ) as response:
            if response.status_code == 429:
                retry_after = response.headers.get("retry-after")
                suffix = f"; retry after {retry_after} seconds" if retry_after else ""
                raise ChatGPTWebError(f"ChatGPT web rate limit reached{suffix}")
            if response.status_code >= 400:
                raise ChatGPTWebError(
                    f"ChatGPT submission returned HTTP {response.status_code}"
                )
            content_type = response.headers.get("content-type", "")
            if "text/event-stream" not in content_type:
                raise ChatGPTWebError(
                    f"ChatGPT returned unexpected content type {content_type or '<missing>'}"
                )
            if on_event:
                on_event({"type":"phase", "status":"Waiting for ChatGPT response…",
                          "submitted": True})
            for line in response.iter_lines():
                if not line.startswith("data: "):
                    continue
                payload = line[6:]
                if payload == "[DONE]":
                    break
                try:
                    event = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                if not isinstance(event, dict):
                    continue
                event_id = event.get("conversation_id")
                if isinstance(event_id, str) and event_id:
                    resolved_id = event_id
                message = event.get("message")
                if not isinstance(message, dict):
                    continue
                author = message.get("author")
                if not isinstance(author, dict) or author.get("role") != "assistant":
                    continue
                text = text_from_parts(message_parts(message.get("content")))
                if not text or text == rendered:
                    continue
                if on_event is not None:
                    if text.startswith(rendered):
                        on_event({"type": "delta", "text": text[len(rendered):]})
                    else:
                        on_event({"type": "replace", "text": text})
                rendered = text
        if not isinstance(resolved_id, str) or not resolved_id:
            raise ChatGPTWebError("ChatGPT did not return a conversation ID")
        return resolved_id, submitted_message_id

    def run_sentinel_node(
        self, arguments: list[str], payload: dict[str, Any] | None = None
    ) -> dict[str, Any]:
        helper = Path(__file__).with_name("sentinel-node-probe.js")
        environment = os.environ.copy()
        try:
            result = subprocess.run(
                [NODE_BINARY, str(helper), *arguments],
                input=json.dumps(payload) if payload is not None else None,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=15,
                check=False,
                env=environment,
            )
        except FileNotFoundError as error:
            raise SentinelCompatibilityError(
                "Node.js 22 or newer is required for signing"
            ) from error
        except subprocess.TimeoutExpired as error:
            raise SentinelCompatibilityError("Sentinel signing timed out") from error
        if result.returncode != 0:
            detail = result.stderr.strip() or "Sentinel signing failed"
            raise SentinelCompatibilityError(detail)
        try:
            value = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise SentinelCompatibilityError(
                "Sentinel signer returned invalid JSON"
            ) from error
        if not isinstance(value, dict):
            raise SentinelCompatibilityError(
                "Sentinel signer returned an invalid result"
            )
        return value

    def create_sentinel_headers(self, on_phase: Any = None) -> dict[str, str]:
        if on_phase:
            on_phase("Preparing verification proof…")
        initial = self.run_sentinel_node(["--emit-initial"]).get("initial")
        if not isinstance(initial, str) or not initial:
            raise SentinelCompatibilityError(
                "Sentinel signer did not generate an initial proof"
            )
        if on_phase:
            on_phase("Checking verification requirements…")
        requirements = self.request(
            "POST",
            urljoin(CHATGPT_ORIGIN, "/backend-api/sentinel/chat-requirements/prepare"),
            json={"p": initial},
            timeout=12,
        ).json()
        if not isinstance(requirements, dict):
            raise ChatGPTWebError("Sentinel prepare returned an invalid response")
        if on_phase:
            on_phase("Completing secure verification…")
        enforcement = self.run_sentinel_node(
            ["--requirements-stdin", "--emit-enforcement-json"], requirements
        )
        prepare_token = requirements.get("prepare_token")
        proof = enforcement.get("proof")
        turnstile = enforcement.get("turnstile")
        if not isinstance(prepare_token, str) or not isinstance(proof, str):
            raise SentinelCompatibilityError(
                "Sentinel did not return required enforcement tokens"
            )
        result = {
            "openai-sentinel-chat-requirements-prepare-token": prepare_token,
            "openai-sentinel-proof-token": proof,
        }
        if isinstance(turnstile, str) and turnstile:
            result["openai-sentinel-turnstile-token"] = turnstile
        return result

    def create_conversation_body(
        self,
        conversation: dict[str, Any] | None,
        prompt: str,
        attachments: list[dict[str, Any]] | None = None,
    ) -> dict[str, Any]:
        parent = conversation.get("current_node") if conversation else None
        if not isinstance(parent, str) or not parent:
            parent = str(uuid.uuid4())
        now = datetime.now().astimezone()
        offset = now.utcoffset()
        offset_minutes = -int(offset.total_seconds() / 60) if offset else 0
        model = getattr(self, "_request_model", None) or load_preferences().get("model") or os.environ.get("CHATGPT_WEB_MODEL")
        if not model and conversation:
            candidate = conversation.get("default_model_slug")
            if isinstance(candidate, str) and candidate:
                model = candidate
        attachments = attachments or []
        content_parts: list[Any] = [prompt]
        attachment_metadata: list[dict[str, Any]] = []
        if attachments:
            content_parts = []
            for attachment in attachments:
                file_id = attachment.get("id")
                if not isinstance(file_id, str) or not file_id.startswith(
                    ("file-", "file_")
                ):
                    raise ChatGPTWebError("invalid uploaded image ID")
                size = attachment.get("size_bytes")
                width = attachment.get("width")
                height = attachment.get("height")
                if not all(
                    isinstance(value, int) and value > 0
                    for value in (size, width, height)
                ):
                    raise ChatGPTWebError("invalid uploaded image dimensions")
                content_parts.append({
                    "content_type": "image_asset_pointer",
                    "asset_pointer": f"file-service://{file_id}",
                    "size_bytes": size,
                    "width": width,
                    "height": height,
                })
                attachment_metadata.append({
                    "id": file_id,
                    "name": attachment.get("name") or "clipboard.png",
                    "mime_type": attachment.get("mime_type") or "image/png",
                    "size": size,
                    "width": width,
                    "height": height,
                })
            content_parts.append(prompt)
        body = {
            "action": "next",
            "messages": [{
                "id": str(uuid.uuid4()),
                "author": {"role": "user"},
                "create_time": time.time(),
                "content": {
                    "content_type": "multimodal_text" if attachments else "text",
                    "parts": content_parts,
                },
                "metadata": {
                    "attachments": attachment_metadata,
                    "selected_sources": [],
                    "serialization_metadata": {"custom_symbol_offsets": []},
                    "submission_mode": "manual_send",
                },
            }],
            "parent_message_id": parent,
            "model": model or "gpt-6",
            "client_prepare_state": "sent",
            "timezone_offset_min": offset_minutes,
            "timezone": os.environ.get("TZ", "Europe/Lisbon"),
            "enable_message_followups": True,
            "system_hints": [],
            "supports_buffering": False,
            "supported_encodings": [],
            "paragen_cot_summary_display_override": "allow",
            "force_parallel_switch": "auto",
            "thinking_effort": getattr(self, "_request_thinking_effort", None) or "extended",
            "local_function_names": ["local.continue_in_work"],
        }
        # Continuing a normal chat must not smuggle in the CLI Project ID.
        # New chats default to the CLI Project; existing chats preserve their own.
        owner = conversation.get("gizmo_id") if conversation is not None else self.target_project_id()
        if isinstance(owner, str) and owner:
            body["conversation_mode"] = {"kind": "gizmo_interaction", "gizmo_id": owner}
            body["gizmo_id"] = owner
            body["conversation_template_id"] = owner
        else:
            body["conversation_mode"] = {"kind": "primary_assistant"}
        if conversation:
            conversation_id = conversation.get("conversation_id") or conversation.get("id")
            if isinstance(conversation_id, str) and conversation_id:
                body["conversation_id"] = conversation_id
        return body

    def upload_image(
        self,
        file_name: str,
        mime_type: str,
        data: bytes,
        width: int,
        height: int,
    ) -> dict[str, Any]:
        if mime_type != "image/png" or not data.startswith(b"\x89PNG\r\n\x1a\n"):
            raise ChatGPTWebError("only PNG clipboard images are currently supported")
        if not data or len(data) > 20 * 1024 * 1024:
            raise ChatGPTWebError("clipboard image must be smaller than 20 MiB")
        slot = self.request(
            "POST",
            urljoin(CHATGPT_ORIGIN, "/backend-api/files"),
            json={
                "file_name": file_name,
                "file_size": len(data),
                "use_case": "multimodal",
            },
        ).json()
        file_id = slot.get("file_id")
        upload_url = slot.get("upload_url")
        if not isinstance(file_id, str) or not isinstance(upload_url, str):
            raise ChatGPTWebError("ChatGPT returned an invalid image upload slot")
        upload = self.http.put(
            upload_url,
            content=data,
            headers={"content-type": mime_type, "x-ms-blob-type": "BlockBlob"},
            timeout=60,
        )
        upload.raise_for_status()
        finalized = self.request(
            "POST",
            urljoin(CHATGPT_ORIGIN, f"/backend-api/files/{file_id}/uploaded"),
            json={},
        ).json()
        if finalized.get("status") != "success":
            raise ChatGPTWebError("ChatGPT did not finalize the image upload")
        return {
            "id": file_id,
            "name": file_name,
            "mime_type": mime_type,
            "size_bytes": len(data),
            "width": width,
            "height": height,
        }

    def capture_send_recipe(
        self, conversation_id: str | None, prompt: str
    ) -> tuple[str, str, dict[str, str], dict[str, Any]]:
        helper = Path(__file__).with_name("chrome-recipe.js")
        environment = os.environ.copy()
        environment["CHATGPT_WEB_CDP_URL"] = self.cdp_url.rstrip("/")
        try:
            captured = subprocess.run(
                [NODE_BINARY, str(helper)],
                input=json.dumps({"conversation_id": conversation_id, "prompt": prompt}),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=110,
                check=False,
                env=environment,
            )
        except FileNotFoundError as error:
            raise ChatGPTWebError("Chrome request preparation failed: Node.js helper not found") from error
        except subprocess.TimeoutExpired as error:
            raise ChatGPTWebError(
                "Chrome request preparation failed: timed out after 110 seconds; "
                "the isolated request tab may need inspection"
            ) from error
        if captured.returncode != 0:
            raise ChatGPTWebError(captured.stderr.strip() or "request preparation failed")
        try:
            recipe = json.loads(captured.stdout)
            url = recipe["url"]
            method = recipe["method"]
            body = json.loads(recipe["postData"])
            headers = {
                key.lower(): value for key, value in recipe["headers"].items()
                if key.lower() not in FORBIDDEN_REPLAY_HEADERS and not key.startswith(":")
            }
        except (KeyError, TypeError, json.JSONDecodeError) as error:
            raise ChatGPTWebError("Chrome returned an invalid send recipe") from error
        parsed = urlsplit(url)
        if (parsed.scheme, parsed.netloc, parsed.path) != (
            "https", "chatgpt.com", "/backend-api/f/conversation"
        ) or method != "POST":
            raise ChatGPTWebError("Chrome returned an unexpected send destination")
        return method, url, headers, body


def message_parts(content: Any) -> list[Any]:
    if not isinstance(content, dict):
        return []
    parts = content.get("parts", [])
    return parts if isinstance(parts, list) else []


def text_from_parts(parts: Iterable[Any]) -> str:
    rendered: list[str] = []
    for part in parts:
        if isinstance(part, str):
            rendered.append(part)
        elif isinstance(part, dict):
            text = part.get("text")
            if isinstance(text, str):
                rendered.append(text)
            else:
                rendered.append(json.dumps(part, ensure_ascii=False, sort_keys=True))
        elif part is not None:
            rendered.append(str(part))
    return "\n".join(rendered)


def normalize_message(message: dict[str, Any]) -> dict[str, Any]:
    author = message.get("author")
    author = author if isinstance(author, dict) else {}
    content = message.get("content")
    content = content if isinstance(content, dict) else {}
    parts = message_parts(content)
    return {
        "id": message.get("id"),
        "role": author.get("role"),
        "name": author.get("name"),
        "channel": message.get("channel"),
        "recipient": message.get("recipient"),
        "status": message.get("status"),
        "create_time": message.get("create_time"),
        "update_time": message.get("update_time"),
        "content_type": content.get("content_type"),
        "parts": parts,
        "text": text_from_parts(parts),
    }


def normalize_conversation(conversation: dict[str, Any]) -> dict[str, Any]:
    raw_messages = conversation.get("messages", [])
    messages = raw_messages if isinstance(raw_messages, list) else []
    return {
        "id": conversation.get("conversation_id") or conversation.get("id"),
        "title": conversation.get("title"),
        "create_time": conversation.get("create_time"),
        "update_time": conversation.get("update_time"),
        "current_node": conversation.get("current_node"),
        "model": conversation.get("default_model_slug"),
        "gizmo_id": conversation.get("gizmo_id"),
        "messages": [normalize_message(item) for item in messages if isinstance(item, dict)],
        "page_info": conversation.get("page_info"),
    }


def print_conversation_list(items: list[dict[str, Any]], output: str) -> None:
    if output == "json":
        print(json.dumps(items, ensure_ascii=False, indent=2))
    elif output == "jsonl":
        for item in items:
            print(json.dumps(item, ensure_ascii=False, separators=(",", ":")))
    else:
        for item in items:
            print(f"{item.get('id', '')}\t{item.get('title') or 'Untitled'}")


def print_conversation(conversation: dict[str, Any], output: str) -> None:
    normalized = normalize_conversation(conversation)
    if output == "json":
        print(json.dumps(normalized, ensure_ascii=False, indent=2))
    elif output == "jsonl":
        envelope = {key: value for key, value in normalized.items() if key != "messages"}
        envelope["type"] = "conversation"
        print(json.dumps(envelope, ensure_ascii=False, separators=(",", ":")))
        for message in normalized["messages"]:
            print(json.dumps(
                {"type": "message", **message},
                ensure_ascii=False,
                separators=(",", ":"),
            ))
    else:
        print(f"# {normalized.get('title') or 'Untitled'}")
        for message in normalized["messages"]:
            text = message.get("text", "")
            if not text:
                continue
            role = message.get("role") or "unknown"
            name = message.get("name")
            heading = f"{role} ({name})" if name else role
            print(f"\n## {heading}\n\n{text}")


def new_messages(
    conversation: dict[str, Any], previous_ids: set[str]
) -> list[dict[str, Any]]:
    raw = conversation.get("messages", [])
    if not isinstance(raw, list):
        return []
    return [
        normalize_message(item) for item in raw
        if isinstance(item, dict) and item.get("id") not in previous_ids
    ]


def print_prompt_result(result: dict[str, Any], output: str) -> None:
    messages = new_messages(
        result.get("conversation", {}), set(result.get("previous_ids", []))
    )
    if output == "json":
        print(json.dumps({
            "conversation_id": result.get("conversation_id"),
            "messages": messages,
        }, ensure_ascii=False, indent=2))
        return
    if output == "jsonl":
        for message in messages:
            print(json.dumps(
                {"type": "message", **message}, ensure_ascii=False,
                separators=(",", ":"),
            ))
        return
    for message in messages:
        if message.get("role") != "assistant" or not message.get("text"):
            continue
        print(message["text"])


def stream_prompt(
    socket_path: Path,
    conversation_id: str | None,
    prompt: str,
    output: str,
    model: str | None = None,
    thinking_effort: str | None = None,
) -> dict[str, Any]:
    rendered = ""

    def on_event(event: dict[str, Any]) -> None:
        nonlocal rendered
        event_type = event.get("type")
        if output == "jsonl" and event_type != "heartbeat":
            print(json.dumps(event, ensure_ascii=False, separators=(",", ":")),
                  flush=True)
        if output != "text":
            return
        if event_type == "delta":
            text = event.get("text", "")
            if isinstance(text, str):
                print(text, end="", flush=True)
                rendered += text
        elif event_type == "replace":
            text = event.get("text", "")
            if isinstance(text, str):
                print(("\n" if rendered else "") + text, end="", flush=True)
                rendered = text

    result = daemon_stream_request(socket_path, {
        "command": "send_stream",
        "conversation_id": conversation_id,
        "prompt": prompt,
        "model": model,
        "thinking_effort": thinking_effort,
    }, on_event)

    if output == "text":
        messages = new_messages(
            result.get("conversation", {}), set(result.get("previous_ids", []))
        )
        final = "\n".join(
            message.get("text", "") for message in messages
            if message.get("role") == "assistant" and message.get("text")
        )
        if final.startswith(rendered):
            print(final[len(rendered):], end="")
        elif not rendered:
            print(final, end="")
        elif final and final != rendered:
            print(f"\n{final}", end="")
        print()
    else:
        print_prompt_result(result, output)
        if output == "jsonl":
            print(json.dumps({"type": "result", "conversation_id": result.get("conversation_id")}, ensure_ascii=False, separators=(",", ":")), flush=True)
    return result


def conversation_title(conversation: dict[str, Any]) -> str:
    title = conversation.get("title")
    return title if isinstance(title, str) and title.strip() else "Untitled"


def format_timestamp(value: Any) -> str:
    if not isinstance(value, (int, float)):
        return ""
    try:
        return datetime.fromtimestamp(value).strftime("%Y-%m-%d %H:%M")
    except (OverflowError, OSError, ValueError):
        return ""


def choose_conversation(socket_path: Path) -> tuple[str | None, str] | None:
    result = daemon_request(socket_path, {"command": "list", "maximum": 30})
    all_items = result.get("items", [])
    if not isinstance(all_items, list):
        all_items = []
    items = all_items
    while True:
        print("\nRecent conversations\n")
        for index, item in enumerate(items, 1):
            stamp = format_timestamp(item.get("update_time"))
            suffix = f"  {stamp}" if stamp else ""
            print(f"{index:>2}. {conversation_title(item)}{suffix}")
        print("\n[n] New conversation   [/] Search   [q] Quit")
        try:
            choice = input("Select: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        if choice.lower() in ("q", "/exit", "/quit"):
            return None
        if choice.lower() in ("n", "/new"):
            return None, "New conversation"
        if choice == "/":
            query = input("Search titles: ").strip().casefold()
            items = [
                item for item in all_items
                if query in conversation_title(item).casefold()
            ]
            continue
        try:
            selected = items[int(choice) - 1]
        except (ValueError, IndexError):
            print("Choose a listed number, n, /, or q.")
            continue
        conversation_id = selected.get("id")
        if isinstance(conversation_id, str) and conversation_id:
            return conversation_id, conversation_title(selected)


def run_repl(
    socket_path: Path,
    conversation_id: str | None,
    title: str,
) -> str:
    print(f"\nChatGPT Web · {title}")
    print("Type /help for commands. Ctrl+C stops a response.\n")
    while True:
        try:
            prompt = input("❯ ").strip()
        except EOFError:
            print()
            return "exit"
        except KeyboardInterrupt:
            print()
            continue
        if not prompt:
            continue
        if prompt in ("/exit", "/quit"):
            return "exit"
        if prompt == "/list":
            return "list"
        if prompt == "/new":
            conversation_id = None
            title = "New conversation"
            print("Started a new conversation.")
            continue
        if prompt == "/help":
            print("/new      start a new conversation")
            print("/list     return to the conversation picker")
            print("/history  print the current conversation")
            print("/exit     leave chatgpt-web")
            continue
        if prompt == "/history":
            if conversation_id is None:
                print("This conversation has no messages yet.")
                continue
            conversation = daemon_request(socket_path, {
                "command": "show", "conversation_id": conversation_id,
            }).get("conversation", {})
            print_conversation(conversation, "markdown")
            continue
        if prompt.startswith("/"):
            print(f"Unknown command: {prompt}. Type /help.")
            continue
        try:
            result = stream_prompt(socket_path, conversation_id, prompt, "text")
        except KeyboardInterrupt:
            print("\n[interrupted]", file=sys.stderr)
            continue
        previous_id = conversation_id
        conversation_id = result.get("conversation_id", conversation_id)
        if previous_id is None and conversation_id:
            print(f"[conversation {conversation_id}]", file=sys.stderr)


def run_picker(socket_path: Path) -> int:
    while True:
        selected = choose_conversation(socket_path)
        if selected is None:
            return 0
        conversation_id, title = selected
        if run_repl(socket_path, conversation_id, title) == "exit":
            return 0


def run_fullscreen(
    socket_path: Path,
    conversation_id: str | None = None,
    cached_conversation: dict[str, Any] | None = None,
    cdp_url: str = DEFAULT_CDP_URL,
) -> int:
    try:
        from chatgpt_tui import run_tui
    except ImportError as error:
        raise ChatGPTWebError(
            "fullscreen UI dependencies are missing; install chatgpt-web/requirements.txt"
        ) from error

    def ensure_service() -> None:
        ensure_daemon(socket_path, cdp_url)

    def local_legacy_items() -> list[dict[str, Any]]:
        """Older non-Project caches can be recovered for verified continuation."""
        result = []
        configured = load_preferences().get("project_id")
        for path in conversation_cache_dir().glob("*.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if not isinstance(row, dict) or row.get("gizmo_id") == configured:
                continue
            if isinstance(row.get("id"), str):
                result.append({
                    "id": row["id"], "title": row.get("title"),
                    "update_time": row.get("update_time") or row.get("cached_at") or 0,
                })
        return result

    def locally_cached_project_items() -> list[dict[str, Any]]:
        items: list[dict[str, Any]] = []
        project = load_preferences().get("project_id")
        if not project:
            return items
        for path in conversation_cache_dir().glob("*.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if (isinstance(row, dict) and row.get("gizmo_id") == project
                and isinstance(row.get("id"), str)):
                items.append({
                    "id": row["id"],
                    "title": row.get("title") or "Cached CLI chat",
                    "update_time": row.get("update_time") or row.get("cached_at") or 0,
                })
        return items

    def list_recent_cached() -> list[dict[str, Any]]:
        """Synchronous local-only listing; never contacts Chrome or the daemon."""
        return local_history.merge_recent(
            locally_cached_project_items(), legacy=local_legacy_items()
        )

    def list_recent() -> list[dict[str, Any]]:
        """Optional fast remote refresh; cached sessions remain available offline."""
        # The daemon processes calls sequentially. Limit this discovery request
        # to its first page so opening the picker cannot starve chat sends.
        if not socket_path.exists():
            ensure_service()
        else:
            # A ChatGPT send holds the daemon's single worker. If it's busy,
            # skip the optional listing rather than queue another slow call
            # behind it. Cached conversations have already been displayed.
            ready = daemon_request(
                socket_path, {"command": "ping"}, timeout_seconds=0.6
            )
            if ready.get("ready") is not True:
                raise ChatGPTWebError("Chat daemon is busy; showing cached chats")
        result = daemon_request(socket_path, {
            "command": "list", "maximum": 35, "quick": True, "interactive_include_other": True,
        }, timeout_seconds=9)
        online = result.get("items", [])
        if not isinstance(online, list):
            raise ChatGPTWebError("ChatGPT returned an invalid conversations list")
        cached_ids = {row.get("id") for row in online if isinstance(row, dict)}
        online.extend(
            row for row in locally_cached_project_items()
            if row.get("id") not in cached_ids
        )
        # Add local-only sessions exactly once via merge_recent(); feeding
        # their local: IDs in as remote rows would duplicate them.
        return local_history.merge_recent(online, legacy=local_legacy_items())

    def load(selected_id: str) -> dict[str, Any]:
        if selected_id.startswith("local:"):
            snapshot = local_history.load(selected_id[6:])
            if snapshot is None:
                raise ChatGPTWebError("Local session no longer exists")
            return {
                "id": snapshot.get("server_id"),
                "server_id": snapshot.get("server_id"),
                "local_session_id": snapshot["session_id"],
                "title": snapshot.get("title"),
                "messages": snapshot.get("messages", []),
                "last_image": snapshot.get("last_image"),
            }
        if selected_id.startswith("legacy:"):
            legacy_id = selected_id[7:]
            cache_path = conversation_cache_path(legacy_id)
            try:
                old = json.loads(cache_path.read_text(encoding="utf-8"))
            except (OSError, ValueError) as error:
                raise ChatGPTWebError("Older cached chat not found") from error
            if not isinstance(old, dict) or old.get("gizmo_id") == load_preferences().get("project_id"):
                raise ChatGPTWebError("Invalid older cached chat")
            return {
                "id": legacy_id, "server_id": legacy_id, "offline": True,
                "title": old.get("title") or "Older chat",
                "gizmo_id": old.get("gizmo_id"),
                "messages": old.get("messages", []),
            }
        snapshot = local_history.by_server(selected_id)
        if snapshot is not None:
            return {
                "id": selected_id, "server_id": selected_id,
                "local_session_id": snapshot["session_id"],
                "title": snapshot.get("title"),
                "messages": snapshot.get("messages", []),
                "last_image": snapshot.get("last_image"),
            }
        cached = load_cached_conversation(selected_id, allow_external=True)
        if cached is not None:
            # Interactive picker may display older caches; sending verifies the live chat.
            cached["offline"] = True
            return cached
        try:
            ensure_service()
            raw = daemon_request(socket_path, {
                "command": "show_normalized", "conversation_id": selected_id,
                "interactive_allow_external": True,
            }).get("conversation", {})
            if isinstance(raw, dict):
                cache_conversation(raw)
                return raw
        except (ChatGPTWebError, OSError):
            cached = load_cached_conversation(selected_id, allow_external=True)
            if cached is not None:
                cached["offline"] = True
                return cached
            raise
        raise ChatGPTWebError("Conversation could not be loaded")

    def send(
        selected_id: str | None,
        prompt: str,
        attachments: list[dict[str, Any]],
        on_event: Any,
        on_connection: Any,
    ) -> dict[str, Any]:
        ensure_service()
        result = daemon_stream_request(socket_path, {
            "command": "send_stream",
            "conversation_id": selected_id,
            "prompt": prompt,
            "attachments": attachments,
            "interactive_allow_external": True,
        }, on_event, on_connection)
        conversation = result.get("conversation")
        if isinstance(conversation, dict):
            normalized = cache_conversation(conversation)
            files = result.get("media_files")
            if isinstance(files, list):
                normalized["media_files"] = files
                cache_conversation(normalized)
        return result

    def upload_image(
        data: bytes, file_name: str, mime_type: str, width: int, height: int
    ) -> dict[str, Any]:
        ensure_service()
        return daemon_request(socket_path, {
            "command": "upload_image",
            "data": base64.b64encode(data).decode("ascii"),
            "file_name": file_name,
            "mime_type": mime_type,
            "width": width,
            "height": height,
        }).get("attachment", {})

    def rename(selected_id: str, new_title: str) -> None:
        ensure_service()
        daemon_request(socket_path, {
            "command": "rename",
            "conversation_id": selected_id,
            "title": new_title,
            "interactive_allow_external": True,
        })
        rename_cached_conversation(selected_id, new_title)

    def models() -> dict[str, Any]:
        ensure_service()
        return daemon_request(socket_path, {"command": "models"})

    def select_model(slug: str) -> dict[str, Any]:
        ensure_service()
        return daemon_request(socket_path, {"command": "set_model", "model": slug})

    def get_usage() -> dict[str, Any]:
        ensure_service()
        return daemon_request(socket_path, {"command": "usage"})

    # Each terminal owns its own initial session. Global active.json is just
    # the most recently saved pointer for explicit /resume, not an implicit
    # shared chat opened in every terminal.
    local_active = local_history.active() if conversation_id is not None else None
    if local_active is not None and local_active.get("server_id") == conversation_id:
        cached_conversation = {
            "id": local_active.get("server_id"),
            "title": local_active.get("title"),
            "messages": local_active.get("messages", []),
            "model": load_preferences().get("model"),
            "local_session_id": local_active["session_id"],
            "last_image": local_active.get("last_image"),
        }
    cached_id = cached_conversation.get("id") if cached_conversation else None
    cached_messages = cached_conversation.get("messages") if cached_conversation else None
    if isinstance(cached_id, str) and cached_id:
        set_active_conversation(cached_id)
    run_tui(
        list_recent_cached,
        load,
        send,
        conversation_id=conversation_id or (cached_id if isinstance(cached_id, str) else None),
        title=(cached_conversation.get("title") or "Untitled")
              if cached_conversation else
              ("Loading conversation" if conversation_id else "New conversation"),
        initial_messages=cached_messages if isinstance(cached_messages, list) else None,
        model=load_preferences().get("model") or (
            cached_conversation.get("model") if cached_conversation else None
        ),
        upload_image=upload_image,
        rename_conversation=rename,
        set_active_conversation=set_active_conversation,
        list_models=models,
        select_model=select_model,
        get_usage=get_usage,
        local_session_id=(cached_conversation or {}).get("local_session_id"),
        last_image=(cached_conversation or {}).get("last_image"),
        refresh_conversations=list_recent,
    )
    return 0


def receive_json(
    connection: socket.socket,
    maximum: int | None = MAX_DAEMON_MESSAGE,
) -> dict[str, Any]:
    chunks: list[bytes] = []
    size = 0
    while True:
        chunk = connection.recv(65536)
        if not chunk:
            break
        chunks.append(chunk)
        size += len(chunk)
        if maximum is not None and size > maximum:
            raise ChatGPTWebError("daemon message exceeded the size limit")
    try:
        value = json.loads(b"".join(chunks))
    except json.JSONDecodeError as error:
        raise ChatGPTWebError("daemon received invalid JSON") from error
    if not isinstance(value, dict):
        raise ChatGPTWebError("daemon message was not an object")
    return value


def send_json(connection: socket.socket, value: dict[str, Any]) -> None:
    connection.sendall(json.dumps(
        value, ensure_ascii=False, separators=(",", ":")
    ).encode("utf-8"))


def send_json_line(connection: socket.socket, value: dict[str, Any]) -> None:
    connection.sendall((json.dumps(
        value, ensure_ascii=False, separators=(",", ":")
    ) + "\n").encode("utf-8"))


def daemon_request(
    socket_path: Path, request: dict[str, Any], *,
    timeout_seconds: float = 120,
) -> dict[str, Any]:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    connection.settimeout(timeout_seconds)
    try:
        connection.connect(str(socket_path))
        send_json(connection, request)
        connection.shutdown(socket.SHUT_WR)
        # Conversation history can legitimately exceed the command-size limit.
        # The daemon is local and trusted; only cap requests entering it.
        response = receive_json(connection, maximum=None)
    finally:
        connection.close()
    if not response.get("ok"):
        raise ChatGPTWebError(response.get("error", "daemon request failed"))
    result = response.get("result", {})
    if not isinstance(result, dict):
        raise ChatGPTWebError("daemon returned an invalid result")
    return result


def daemon_stream_request(
    socket_path: Path,
    request: dict[str, Any],
    on_event: Any,
    on_connection: Any = None,
) -> dict[str, Any]:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    # Coding responses can legitimately run much longer than five minutes.
    # The external fleet still enforces its own bounded 1,250-second worker
    # deadline. A short idle socket timeout was incorrectly aborting valid
    # ChatGPT Web conversations before their source output was finished.
    connection.settimeout(1160)
    result: dict[str, Any] | None = None
    try:
        connection.connect(str(socket_path))
        if on_connection is not None:
            on_connection(connection)
        send_json(connection, request)
        connection.shutdown(socket.SHUT_WR)
        stream = connection.makefile("r", encoding="utf-8")
        for line in stream:
            message = json.loads(line)
            if not message.get("ok"):
                raise ChatGPTWebError(message.get("error", "daemon request failed"))
            if "event" in message:
                on_event(message["event"])
            elif "result" in message:
                result = message["result"]
    finally:
        if on_connection is not None:
            on_connection(None)
        connection.close()
    if not isinstance(result, dict):
        raise ChatGPTWebError("daemon stream ended without a result")
    return result


def daemon_is_ready(socket_path: Path) -> bool:
    try:
        return daemon_request(
            socket_path, {"command": "ping"}, timeout_seconds=1.5
        ).get("ready") is True
    except (ChatGPTWebError, OSError):
        return False


def start_daemon(socket_path: Path, cdp_url: str) -> None:
    socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(socket_path.parent, 0o700)
    command = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--cdp-url", cdp_url,
        "daemon",
        "--socket", str(socket_path),
    ]
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    deadline = time.monotonic() + 22
    while time.monotonic() < deadline:
        if daemon_is_ready(socket_path):
            return
        if process.poll() is not None:
            raise ChatGPTWebError(
                "daemon failed to start; ensure the authenticated debugging browser is running"
            )
        time.sleep(0.1)
    process.terminate()
    raise ChatGPTWebError("timed out starting the chatgpt-web daemon")


def chrome_is_ready(cdp_url: str) -> bool:
    try:
        response = httpx.get(f"{cdp_url.rstrip('/')}/json/version", timeout=1.0)
        return response.status_code == 200
    except httpx.HTTPError:
        return False


def chrome_needs_interactive_verification(cdp_url: str) -> bool:
    """Recognize an actual browser-side security challenge; never bypass it."""
    try:
        response = httpx.get(f"{cdp_url.rstrip('/')}/json/list", timeout=2.0)
        response.raise_for_status()
        pages = response.json()
        if not isinstance(pages, list):
            return False
        return any(
            isinstance(page, dict)
            and page.get("type") == "page"
            and str(page.get("url", "")).startswith(CHATGPT_ORIGIN)
            and (
                "just a moment" in str(page.get("title", "")).casefold()
                or "attention required" in str(page.get("title", "")).casefold()
            )
            for page in pages
        )
    except (httpx.HTTPError, ValueError):
        return False


def persistent_profile_path() -> Path:
    data_home = os.environ.get("XDG_DATA_HOME")
    root = Path(data_home) if data_home else Path.home() / ".local" / "share"
    return root / "chatgpt-web" / "chrome-profile"


def launch_login_browser(cdp_url: str) -> dict[str, Any]:
    if chrome_is_ready(cdp_url):
        return {"browser": "already_running", "cdp_url": cdp_url}
    parsed = urlsplit(cdp_url)
    if parsed.scheme != "http" or parsed.hostname not in ("127.0.0.1", "localhost"):
        raise ChatGPTWebError("automatic browser launch requires a local HTTP CDP URL")
    port = parsed.port or 9222
    browser = next((
        shutil.which(name) for name in
        ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser")
        if shutil.which(name)
    ), None)
    if not browser:
        raise ChatGPTWebError("Chrome or Chromium was not found")
    profile = persistent_profile_path()
    profile.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(profile, 0o700)
    subprocess.Popen(
        [
            browser,
            f"--user-data-dir={profile}",
            "--remote-debugging-address=127.0.0.1",
            f"--remote-debugging-port={port}",
            "--no-first-run",
            "--no-default-browser-check",
            "--new-window",
            "https://chatgpt.com/",
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if chrome_is_ready(cdp_url):
            return {
                "browser": "started",
                "cdp_url": cdp_url,
                "profile": str(profile),
                "login_required": True,
            }
        time.sleep(0.1)
    raise ChatGPTWebError("Chrome started but its debugger did not become ready")


def ensure_daemon(socket_path: Path, cdp_url: str) -> None:
    if socket_path.exists():
        try:
            if daemon_request(
                socket_path, {"command": "ping"}, timeout_seconds=1.5,
            ).get("ready") is True:
                return
        except socket.timeout as error:
            # A socket exists but the single-worker daemon is answering
            # another ChatGPT request; do not launch a competing daemon or
            # queue another generation request behind it for two minutes.
            raise ChatGPTWebError(
                "CLI backend is busy with another request; your prompt was not "
                "submitted by this attempt. Wait for the other request to finish."
            ) from error
        except (ChatGPTWebError, OSError):
            pass
    start_daemon(socket_path, cdp_url)


def handle_daemon_command(
    client: ChatGPTWebClient, request: dict[str, Any]
) -> tuple[dict[str, Any], bool]:
    command = request.get("command")
    if command == "ping":
        return {"ready": True}, False
    if command == "auth":
        if request.get("refresh"):
            client.refresh_auth(prefer_browser=True)
        response = client.verify()
        items = response.get("items", [])
        return {
            "authenticated": True,
            "first_page_count": len(items) if isinstance(items, list) else None,
        }, False
    if command == "status":
        return {
            "daemon": "running",
            "session_saved": auth_store_path().is_file(),
            "chrome": "running" if chrome_is_ready(client.cdp_url) else "stopped",
            "send_mode": os.environ.get("CHATGPT_WEB_SEND_MODE", "node"),
            "sentinel_cache": sentinel_cache_status(),
        }, False
    if command == "project":
        return {"project": PROJECT_NAME, "project_id": client.target_project_id()}, False
    if command == "models":
        return client.model_status(), False
    if command == "models_catalog":
        return {"models": client.available_models()}, False
    if command == "model_capabilities":
        return {"models": client.model_capabilities()}, False
    if command == "set_model":
        slug = request.get("model")
        if not isinstance(slug, str):
            raise ChatGPTWebError("Model slug is required")
        return client.set_model(slug), False
    if command == "usage":
        return client.usage_status(), False
    if command == "list":
        maximum = request.get("maximum")
        if maximum is not None and (not isinstance(maximum, int) or maximum < 1):
            raise ChatGPTWebError("invalid conversation limit")
        quick = request.get("quick") is True
        if request.get("interactive_include_other") is True:
            return {"items": client.list_conversations(maximum)}, False
        return {
            "items": client.list_project_conversations(
                maximum, max_pages=1 if quick else None,
                page_timeout=6.0 if quick else None,
            )
        }, False
    if command == "show":
        conversation_id = request.get("conversation_id")
        if not isinstance(conversation_id, str) or not conversation_id:
            raise ChatGPTWebError("conversation ID is required")
        conversation = client.get_conversation(conversation_id)
        if (conversation.get("gizmo_id") != client.target_project_id()
                and request.get("interactive_allow_external") is not True):
            raise ChatGPTWebError("This conversation is outside the CLI Project")
        return {"conversation": conversation}, False
    if command == "show_normalized":
        conversation_id = request.get("conversation_id")
        if not isinstance(conversation_id, str) or not conversation_id:
            raise ChatGPTWebError("conversation ID is required")
        conversation = client.get_conversation(conversation_id)
        if (conversation.get("gizmo_id") != client.target_project_id()
                and request.get("interactive_allow_external") is not True):
            raise ChatGPTWebError("This conversation is outside the CLI Project")
        normalized = cache_conversation(conversation)
        try:
            normalized["media_files"] = download_generated_images(
                client, conversation, conversation_cache_dir().parent / "images" / "web-generated"
            )
        except (ValueError, httpx.HTTPError, OSError, ChatGPTWebError) as error:
            normalized["media_warning"] = str(error)[:200]
        cache_conversation(normalized)
        return {"conversation": normalized}, False
    if command == "rename":
        conversation_id = request.get("conversation_id")
        title = request.get("title")
        if not isinstance(conversation_id, str) or not conversation_id:
            raise ChatGPTWebError("conversation ID is required")
        if not isinstance(title, str) or not title.strip():
            raise ChatGPTWebError("conversation title is required")
        title = title.strip()
        if len(title) > 256:
            raise ChatGPTWebError("conversation title must be 256 characters or fewer")
        if (client.get_conversation(conversation_id).get("gizmo_id") != client.target_project_id()
                and request.get("interactive_allow_external") is not True):
            raise ChatGPTWebError("This conversation is outside the CLI Project")
        client.rename_conversation(conversation_id, title)
        return {"conversation_id": conversation_id, "title": title}, False
    if command == "send":
        conversation_id = request.get("conversation_id")
        prompt = request.get("prompt")
        attachments = request.get("attachments", [])
        if conversation_id is not None and not isinstance(conversation_id, str):
            raise ChatGPTWebError("invalid conversation ID")
        if not isinstance(prompt, str) or (not prompt.strip() and not attachments):
            raise ChatGPTWebError("prompt or attachment is required")
        if not isinstance(attachments, list):
            raise ChatGPTWebError("invalid attachment list")
        resolved_id, conversation, previous_ids = client.send_prompt(
            conversation_id, prompt, attachments,
            allow_existing_outside_project=request.get("interactive_allow_external") is True,
        )
        cache_conversation(conversation)
        return {
            "conversation_id": resolved_id,
            "conversation": conversation,
            "previous_ids": sorted(previous_ids),
        }, False
    if command == "upload_image":
        encoded = request.get("data")
        file_name = request.get("file_name")
        mime_type = request.get("mime_type")
        width = request.get("width")
        height = request.get("height")
        if not isinstance(encoded, str) or not isinstance(file_name, str):
            raise ChatGPTWebError("invalid image upload request")
        if (
            mime_type != "image/png"
            or not isinstance(width, int)
            or not isinstance(height, int)
        ):
            raise ChatGPTWebError("invalid image upload metadata")
        try:
            data = base64.b64decode(encoded, validate=True)
        except ValueError as error:
            raise ChatGPTWebError("invalid image upload data") from error
        return {"attachment": client.upload_image(
            file_name, mime_type, data, width, height
        )}, False
    if command == "stop":
        return {"stopping": True}, True
    raise ChatGPTWebError(f"unknown daemon command: {command}")



MAX_CONCURRENT_REQUESTS = 8


def client_for_connection(
    cdp_url: str, initial_url: str, initial_headers: dict[str, str],
) -> ChatGPTWebClient:
    """Use isolated session state and HTTP connection per worker.

    Never share the mutable auth headers or the streaming httpx.Client across
    simultaneous CLI requests. Authenticate the daemon once on startup.
    """
    client = object.__new__(ChatGPTWebClient)
    client.cdp_url = cdp_url
    client.list_url = initial_url
    client.headers = initial_headers.copy()
    client.http = httpx.Client(
        follow_redirects=False, timeout=httpx.Timeout(30.0),
    )
    return client


def process_daemon_connection(
    connection: socket.socket,
    request: dict[str, Any],
    client: ChatGPTWebClient,
    active_conversations: set[str],
    active_lock: threading.Lock,
    stop_event: threading.Event,
) -> None:
    """Handle a single request without blocking other terminals' requests."""
    command = request.get("command")
    conversation_id = request.get("conversation_id")
    locked_id = None
    if command in ("send", "send_stream") and isinstance(conversation_id, str):
        with active_lock:
            if conversation_id in active_conversations:
                raise ChatGPTWebError(
                    "Another terminal is already sending in this conversation. "
                    "Different CLI Project chats can run concurrently."
                )
            active_conversations.add(conversation_id)
            locked_id = conversation_id
    try:
        if command == "send_stream":
            prompt = request.get("prompt")
            attachments = request.get("attachments", [])
            if conversation_id is not None and not isinstance(conversation_id, str):
                raise ChatGPTWebError("invalid conversation ID")
            if not isinstance(prompt, str) or (
                not prompt.strip() and not attachments
            ):
                raise ChatGPTWebError("prompt or attachment is required")
            if not isinstance(attachments, list):
                raise ChatGPTWebError("invalid attachment list")
            requested_model = request.get("model")
            if requested_model is not None:
                if not isinstance(requested_model, str) or not MODEL_RE.fullmatch(requested_model):
                    raise ChatGPTWebError("Invalid model identifier")
                if requested_model not in {item["slug"] for item in client.available_models()}:
                    raise ChatGPTWebError("Requested model is not selectable for this account")
            requested_effort = request.get("thinking_effort")
            if requested_effort is not None:
                if requested_effort not in ("standard", "extended"):
                    raise ChatGPTWebError("Unsupported thinking effort")
                selected = requested_model or load_preferences().get("model")
                capabilities = next(
                    (m for m in client.model_capabilities() if m["slug"] == selected),
                    None,
                )
                if capabilities is None or requested_effort not in {
                    item["thinking_effort"] for item in capabilities["efforts"]
                }:
                    raise ChatGPTWebError(
                        "Selected model does not support that thinking effort"
                    )
            client._request_model = requested_model
            client._request_thinking_effort = requested_effort
            resolved_id, conversation, previous_ids = client.send_prompt(
                conversation_id, prompt, attachments,
                lambda event: send_json_line(connection, {"ok": True, "event": event}),
                allow_existing_outside_project=request.get("interactive_allow_external") is True,
            )
            normalized = cache_conversation(conversation)
            media_paths: list[str] = []
            media_warning = None
            if image_asset_ids(conversation):
                send_json_line(connection, {"ok": True, "event": {
                    "type": "phase", "status": "Saving generated image locally…",
                    "submitted": True,
                }})
                try:
                    media_paths = download_generated_images(
                        client, conversation,
                        conversation_cache_dir().parent / "images" / "web-generated",
                    )
                except (ValueError, httpx.HTTPError, OSError, ChatGPTWebError) as error:
                    media_warning = str(error)[:200]
            normalized["media_files"] = media_paths
            if media_warning:
                normalized["media_warning"] = media_warning
            cache_conversation(normalized)
            send_json_line(connection, {"ok": True, "result": {
                "conversation_id": resolved_id,
                "conversation": conversation,
                "previous_ids": sorted(previous_ids),
                "media_files": media_paths,
                "media_warning": media_warning,
            }})
        else:
            result, should_stop = handle_daemon_command(client, request)
            send_json(connection, {"ok": True, "result": result})
            if should_stop:
                stop_event.set()
    finally:
        if locked_id is not None:
            with active_lock:
                active_conversations.discard(locked_id)


def run_daemon(socket_path: Path, cdp_url: str) -> int:
    socket_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(socket_path.parent, 0o700)
    lock_path = socket_path.with_suffix(".lock")
    lock = open(lock_path, "a+", encoding="utf-8")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return 0

    if socket_path.exists():
        socket_path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stop_event = threading.Event()
    active_lock = threading.Lock()
    active_conversations: set[str] = set()
    slots = threading.BoundedSemaphore(MAX_CONCURRENT_REQUESTS)

    def request_stop(_signum: int, _frame: object) -> None:
        stop_event.set()

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    def handle_worker(
        connection: socket.socket,
        request: dict[str, Any],
        auth_url: str,
        auth_headers: dict[str, str],
    ) -> None:
        try:
            with connection:
                with client_for_connection(cdp_url, auth_url, auth_headers) as client:
                    try:
                        process_daemon_connection(
                            connection, request, client,
                            active_conversations, active_lock, stop_event,
                        )
                    except (ChatGPTWebError, httpx.HTTPError, OSError, ValueError) as error:
                        try:
                            send_json_line(connection, {"ok": False, "error": str(error)})
                        except OSError:
                            pass
        finally:
            slots.release()

    try:
        # A valid saved session is enough to start the local daemon. Avoid
        # re-capturing browser traffic on every restart: Chrome may be open
        # but unable to produce the auth probe while other work is running.
        try:
            bootstrap_url, bootstrap_headers = load_auth_snapshot()
        except ChatGPTWebError:
            bootstrap = ChatGPTWebClient(cdp_url)
        else:
            bootstrap = client_for_connection(
                cdp_url, bootstrap_url, bootstrap_headers,
            )
        with bootstrap:
            server.bind(str(socket_path))
            os.chmod(socket_path, 0o600)
            server.listen(32)
            server.settimeout(0.25)
            with ThreadPoolExecutor(
                max_workers=MAX_CONCURRENT_REQUESTS, thread_name_prefix="cli-web"
            ) as workers:
                while not stop_event.is_set():
                    try:
                        connection, _ = server.accept()
                    except socket.timeout:
                        continue
                    except OSError:
                        if stop_event.is_set():
                            break
                        raise
                    # Read only a small control envelope on the accept loop.
                    # An unresponsive client cannot keep this loop blocked.
                    connection.settimeout(3.0)
                    try:
                        request = receive_json(connection)
                        connection.settimeout(None)
                    except (OSError, ChatGPTWebError) as error:
                        with connection:
                            try:
                                send_json_line(connection, {"ok": False, "error": str(error)})
                            except OSError:
                                pass
                        continue
                    command = request.get("command")
                    if command == "ping":
                        with connection:
                            send_json(connection, {"ok": True, "result": {"ready": True}})
                        continue
                    if not slots.acquire(blocking=False):
                        with connection:
                            send_json_line(connection, {"ok": False, "error":
                                "CLI has 8 active requests. Wait for a free slot."
                            })
                        continue
                    # Refresh each worker's credentials from the atomic shared
                    # auth snapshot when available; this also picks up a recent
                    # account session refresh performed by another worker.
                    try:
                        auth_url, auth_headers = load_auth_snapshot()
                    except ChatGPTWebError:
                        auth_url, auth_headers = bootstrap.list_url, bootstrap.headers.copy()
                    try:
                        workers.submit(handle_worker, connection, request, auth_url, auth_headers)
                    except RuntimeError:
                        slots.release()
                        connection.close()
                        if not stop_event.is_set():
                            raise
    finally:
        server.close()
        socket_path.unlink(missing_ok=True)
        lock.close()
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="chatgpt-web")
    parser.add_argument(
        "--cdp-url",
        default=os.environ.get("CHATGPT_WEB_CDP_URL", DEFAULT_CDP_URL),
        help="Chrome DevTools HTTP endpoint (default: %(default)s)",
    )
    parser.add_argument(
        "--socket",
        type=Path,
        default=default_socket_path(),
        help="daemon Unix socket (default: %(default)s)",
    )
    commands = parser.add_subparsers(dest="command")
    image_parser = commands.add_parser(
        "image", help="generate, edit or animate an image with image-use (JSON result)"
    )
    image_parser.add_argument("action", choices=("generate", "edit", "animate"))
    image_parser.add_argument("--prompt", required=True)
    image_parser.add_argument("--reference")
    image_parser.add_argument("--output")
    image_parser.add_argument("--backend", default="auto", choices=("auto", "web", "codex"))
    image_parser.add_argument("--timeout", type=int, default=360)
    commands.add_parser("login", help="launch the persistent login browser")
    auth_parser = commands.add_parser(
        "auth", help="verify the saved ChatGPT session"
    )
    auth_parser.add_argument(
        "--refresh", action="store_true", help="recapture credentials from Chrome"
    )

    list_parser = commands.add_parser("list", help="list conversations")
    extent = list_parser.add_mutually_exclusive_group()
    extent.add_argument("--all", action="store_true", help="fetch every page")
    extent.add_argument("--limit", type=int, default=DEFAULT_PAGE_SIZE)
    list_parser.add_argument(
        "--output", choices=("table", "json", "jsonl"), default="table"
    )

    show_parser = commands.add_parser("show", help="show one conversation")
    show_parser.add_argument("conversation_id")
    show_parser.add_argument(
        "--output", choices=("markdown", "json", "jsonl"), default="markdown"
    )
    rename_parser = commands.add_parser("rename", help="rename a conversation")
    rename_parser.add_argument("conversation_id")
    rename_parser.add_argument("title", nargs="+")
    send_parser = commands.add_parser("send", help="send a prompt")
    send_parser.add_argument("conversation_id")
    send_parser.add_argument("prompt", nargs="*")
    send_parser.add_argument("--model", help="per-request model override, safe for parallel sessions")
    send_parser.add_argument("--thinking-effort", choices=("standard", "extended"),
                           help="per-request reasoning level if supported by the model")
    send_parser.add_argument(
        "--output", choices=("text", "json", "jsonl"), default="text"
    )
    new_parser = commands.add_parser("new", help="start a new conversation")
    new_parser.add_argument("prompt", nargs="*")
    new_parser.add_argument("--model", help="per-request model override, safe for parallel sessions")
    new_parser.add_argument("--thinking-effort", choices=("standard", "extended"),
                           help="per-request reasoning level if supported by the model")
    new_parser.add_argument(
        "--output", choices=("text", "json", "jsonl"), default="text"
    )
    resume_parser = commands.add_parser("resume", help="open an interactive conversation")
    resume_parser.add_argument("conversation_id")
    daemon_parser = commands.add_parser(
        "daemon", help="run the background service in the foreground"
    )
    daemon_parser.add_argument("--socket", dest="daemon_socket", type=Path)
    commands.add_parser("status", help="show daemon, session, and browser state")
    commands.add_parser("usage", help="show the honest ChatGPT Web quota status")
    model_parser = commands.add_parser("model", help="list models or select one")
    model_parser.add_argument("slug", nargs="?")
    commands.add_parser("project", help="show the enforced CLI Project")
    commands.add_parser("stop", help="stop the background daemon")
    commands.add_parser("logout", help="stop the daemon and delete saved credentials")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.command == "image":
            from image_backend import generate_image
            try:
                result = generate_image(
                    args.action, args.prompt, reference=args.reference,
                    output=args.output, backend=args.backend, timeout=args.timeout,
                )
            except (ValueError, RuntimeError) as error:
                print(json.dumps({"ok": False, "error": str(error)}))
                return 1
            print(json.dumps({"ok": True, **vars(result)}))
            return 0
        if args.command == "login":
            print(json.dumps(
                launch_login_browser(args.cdp_url), separators=(",", ":")
            ))
            return 0
        if args.command == "daemon":
            return run_daemon(args.daemon_socket or args.socket, args.cdp_url)
        if args.command == "stop":
            result = daemon_request(args.socket, {"command": "stop"})
            print(json.dumps(result, separators=(",", ":")))
            return 0
        if args.command == "logout":
            if daemon_is_ready(args.socket):
                daemon_request(args.socket, {"command": "stop"})
            path = auth_store_path()
            path.unlink(missing_ok=True)
            print(json.dumps({"logged_out": True}, separators=(",", ":")))
            return 0

        if args.command is None:
            if not sys.stdin.isatty():
                raise ChatGPTWebError(
                    "interactive mode requires a terminal; use new or send for piped input"
                )
            # Fresh terminal, fresh session; past chats remain in /resume.
            return run_fullscreen(args.socket, cdp_url=args.cdp_url)
        if args.command == "resume":
            cached = load_cached_conversation(args.conversation_id)
            return run_fullscreen(
                args.socket,
                args.conversation_id,
                cached_conversation=cached,
                cdp_url=args.cdp_url,
            )

        ensure_daemon(args.socket, args.cdp_url)
        if args.command == "auth":
            result = daemon_request(
                args.socket, {"command": "auth", "refresh": args.refresh}
            )
            print(json.dumps(result, separators=(",", ":")))
        elif args.command == "status":
            result = daemon_request(args.socket, {"command": "status"})
            print(json.dumps(result, separators=(",", ":")))
        elif args.command == "project":
            print(json.dumps(daemon_request(args.socket, {"command": "project"}), ensure_ascii=False))
        elif args.command == "usage":
            print(json.dumps(daemon_request(args.socket, {"command": "usage"}), ensure_ascii=False, indent=2))
        elif args.command == "model":
            request = {"command": "set_model", "model": args.slug} if args.slug else {"command": "models"}
            print(json.dumps(daemon_request(args.socket, request), ensure_ascii=False, indent=2))
        elif args.command == "list":
            if args.limit is not None and args.limit < 1:
                raise ChatGPTWebError("--limit must be greater than zero")
            result = daemon_request(args.socket, {
                "command": "list",
                "maximum": None if args.all else args.limit,
            })
            print_conversation_list(result.get("items", []), args.output)
        elif args.command == "show":
            result = daemon_request(args.socket, {
                "command": "show",
                "conversation_id": args.conversation_id,
            })
            print_conversation(result.get("conversation", {}), args.output)
        elif args.command == "rename":
            result = daemon_request(args.socket, {
                "command": "rename",
                "conversation_id": args.conversation_id,
                "title": " ".join(args.title),
            })
            print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
        elif args.command in ("send", "new"):
            prompt = " ".join(args.prompt).strip()
            if not prompt and not sys.stdin.isatty():
                prompt = sys.stdin.read().strip()
            if not prompt:
                raise ChatGPTWebError("provide a prompt argument or pipe one on stdin")
            result = stream_prompt(
                args.socket,
                args.conversation_id if args.command == "send" else None,
                prompt,
                args.output,
                args.model,
                args.thinking_effort,
            )
            if args.command == "new" and args.output == "text":
                print(f"\n[conversation {result.get('conversation_id')}]", file=sys.stderr)

    except KeyboardInterrupt:
        print("\n[interrupted]", file=sys.stderr)
        return 130
    except (ChatGPTWebError, httpx.HTTPError) as error:
        print(f"chatgpt-web: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
