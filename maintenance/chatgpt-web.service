[Unit]
StartLimitIntervalSec=5min
StartLimitBurst=3
Description=ChatGPT Web CLI daemon for BB
Wants=network-online.target qwqc-image-browser-session.service
After=network-online.target qwqc-image-browser-session.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/chatgpt-web --cdp-url http://127.0.0.1:9334 daemon
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
