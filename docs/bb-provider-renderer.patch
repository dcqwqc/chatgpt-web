+++ b/apps/app/src/components/thread/timeline/ProviderContentRenderer.tsx
@@ -0,0 +1,70 @@
+import {
+  createContext,
+  useContext,
+  useSyncExternalStore,
+  type ReactNode,
+} from "react";
+import type { ExperimentalProviderRendererContent } from "@get-bb/plugin-sdk";
+import { PluginSlotMount } from "../../plugin/PluginSlotMount.js";
+import { useThreadProvider } from "../thread-provider-context.js";
+import {
+  EMPTY_PLUGIN_SLOT_SNAPSHOT,
+  getPluginSlotSnapshot,
+  subscribePluginSlots,
+} from "@/lib/plugin-slots";
+import { resolveProviderRenderer } from "@/lib/provider-renderer-resolution";
+
+const OriginalContent = createContext<ReactNode>(null);
+
+function Original() {
+  return useContext(OriginalContent);
+}
+
+export function ProviderContentRenderer({
+  content,
+  children,
+}: {
+  content: ExperimentalProviderRendererContent;
+  children: ReactNode;
+}) {
+  const { providerId } = useThreadProvider();
+  const slots = useSyncExternalStore(
+    subscribePluginSlots,
+    () => getPluginSlotSnapshot().providerRenderers,
+    () => EMPTY_PLUGIN_SLOT_SNAPSHOT.providerRenderers,
+  );
+  const slot = resolveProviderRenderer(slots, providerId, content.surface);
+  if (slot === null || providerId === null) return children;
+  const identity =
+    content.surface === "assistant-message" ? content.message : content.row;
+  const rendered = (
+    <slot.component
+      providerId={providerId}
+      content={content}
+      Original={Original}
+    />
+  );
+  return (
+    <OriginalContent.Provider value={children}>
+      <PluginSlotMount
+        pluginId={slot.pluginId}
+        slotKind="providerRenderer"
+        slotId={slot.id}
+        instanceId={`${providerId}/${content.surface}/${identity.threadId}/${identity.id}`}
+        crashResetKey={JSON.stringify(content)}
+        crashFallback={children}
+        wrapRoot={false}
+      >
+        {content.surface === "assistant-message" ? (
+          <div data-bb-plugin-root="" data-bb-plugin={slot.pluginId}>
+            {rendered}
+          </div>
+        ) : (
+          <span data-bb-plugin-root="" data-bb-plugin={slot.pluginId}>
+            {rendered}
+          </span>
+        )}
+      </PluginSlotMount>
+    </OriginalContent.Provider>
+  );
+}
