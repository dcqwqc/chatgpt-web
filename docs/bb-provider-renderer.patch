new file mode 100644
index 0000000..94a5fa8
--- /dev/null
+++ b/apps/app/qa/provider-renderer/README.md
@@ -0,0 +1,34 @@
+# Provider renderer source fixture
+
+This fixture renders real BB source components and the new registration path.
+It is not a deployed host, an actual tool execution, or a native ChatGPT capture.
+The synthetic message/tool rows are identical across provider contexts. Only the
+explicitly opted-in provider receives demo typography and tool header content.
+The chosen typography is demonstrative, not an asserted native measurement.
+
+From the repository root, install locked dependencies, then use Turbo for types:
+`pnpm exec turbo run typecheck --filter=@bb/app --filter=@get-bb/plugin-sdk`.
+Start only the fixture: `pnpm --filter @bb/app exec vite --config
+qa/provider-renderer/vite.config.ts`. It binds loopback on 4189 with no production
+API proxy. Supply `--port` if needed and pass its URL to the capture runner.
+
+With Python Playwright and a Chromium executable already installed, run:
+`python3 apps/app/qa/provider-renderer/capture.py --chromium "$CHROMIUM"
+--out "$EVIDENCE"`. The runner captures actual source UI at 520/1500 CSS px,
+DPR 1, light/dark, enabled/disabled. It waits for fonts, checks horizontal overflow,
+compares the untargeted provider's content/styles, verifies unchanged message text
+and code font, and measures changed heading styles. It blocks API requests and
+never sends a prompt. No preferences or production service state are changed.
+
+The standard orchestration test entry is `pnpm exec turbo run test
+--filter=@bb/app -- --run src/lib/provider-renderer-resolution.test.ts
+src/components/thread/timeline/ProviderContentRenderer.test.tsx`. Its native
+module prerequisite can be expensive on a fresh worktree. For deliberate
+no-database test investigation, use `pnpm --filter @bb/app exec vitest run
+--config vitest.config.ts` with those same paths and the existing streaming,
+row-presentation, disclosure and provider-context test files.
+
+The API declaration, registration validation, host resolution and real message/
+row call sites are all source changes. No vendor distribution file is patched.
+Source tests do not prove deployment, ACP revision support, native typography or
+whole-timeline equality. Stop only this fixture server when finished.
diff --git a/apps/app/qa/provider-renderer/capture.py b/apps/app/qa/provider-renderer/capture.py
new file mode 100644
index 0000000..e522a1d
--- /dev/null
+++ b/apps/app/qa/provider-renderer/capture.py
@@ -0,0 +1,44 @@
+import argparse, asyncio, json
+from pathlib import Path
+from playwright.async_api import async_playwright
+async def main(args):
+ out=Path(args.out);out.mkdir(exist_ok=True)
+ report={'surface':'isolated BB 0.48.0 source fixture, not deployed and not native ChatGPT','results':[],'errors':[]}
+ async with async_playwright() as p:
+  browser=await p.chromium.launch(executable_path=args.chromium,args=['--no-sandbox'])
+  try:
+   for width in (520,1500):
+    for theme in ('light','dark'):
+     for enabled in (0,1):
+      page=await browser.new_page(viewport={'width':width,'height':1200},color_scheme=theme,device_scale_factor=1)
+      page.on('pageerror',lambda err:report['errors'].append(str(err)))
+      await page.route('**/api/v1/**',lambda route:route.abort())
+      await page.goto(f'{args.url.rstrip("/")}/qa/provider-renderer/index.html?theme={theme}&enabled={enabled}',wait_until='domcontentloaded',timeout=60000)
+      await page.locator('[data-provider="codex"] h2').wait_for(timeout=60000)
+      await page.evaluate('document.fonts.ready')
+      data=await page.locator('main').evaluate('''el=>({width:innerWidth,scrollWidth:document.documentElement.scrollWidth,providers:[...el.querySelectorAll('[data-provider]')].map(s=>({provider:s.dataset.provider,headings:[...s.querySelectorAll('h2,h3')].map(h=>({tag:h.tagName,text:h.textContent,fontSize:getComputedStyle(h).fontSize,marginTop:getComputedStyle(h).marginTop,marginBottom:getComputedStyle(h).marginBottom})),bodyFont:getComputedStyle(s.querySelector('p')).fontSize,fontFamily:getComputedStyle(s.querySelector('p')).fontFamily,codeFont:getComputedStyle(s.querySelector('code')).fontSize,messageText:s.querySelector('[data-message-column]').textContent,text:s.textContent}))})''')
+      data.update(theme=theme,enabled=bool(enabled));report['results'].append(data)
+      assert data['scrollWidth']<=width,data
+      assert len(data['providers'])==2,data
+      await page.locator('main').screenshot(path=str(out/f'source-{width}-{theme}-{enabled}.png'))
+      await page.close()
+  finally:
+   await browser.close();(out/'report.json').write_text(json.dumps(report,indent=2))
+parser=argparse.ArgumentParser()
+parser.add_argument('--chromium',required=True)
+parser.add_argument('--out',required=True)
+parser.add_argument('--url',default='http://127.0.0.1:4189')
+args=parser.parse_args()
+asyncio.run(main(args))
+r=json.loads((Path(args.out)/'report.json').read_text())
+assert not r['errors'],r['errors']
+for w in (520,1500):
+ for theme in ('light','dark'):
+  pair=[v for v in r['results'] if v['width']==w and v['theme']==theme]
+  assert len(pair)==2
+  before,after=pair
+  assert before['providers'][1]==after['providers'][1], 'Codex changed'
+  assert before['providers'][0]['messageText']==after['providers'][0]['messageText'], 'Source content changed'
+  assert before['providers'][0]['codeFont']==after['providers'][0]['codeFont'], 'Original code font changed'
+  assert before['providers'][0]['headings'][0]['fontSize']=='15px'
+  assert after['providers'][0]['headings'][0]['fontSize']=='20px'
