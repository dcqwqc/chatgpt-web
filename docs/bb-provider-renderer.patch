+import { afterEach, describe, expect, it } from "vitest";
+import { collectPluginAppRegistrations } from "./plugin-app-definition";
+import { resolveProviderRenderer } from "./provider-renderer-resolution";
+import {
+  getPluginSlotSnapshot,
+  resetPluginSlotStoreForTest,
+  setPluginSlotRegistrations,
+} from "./plugin-slots";
+import { makePluginRegistrationSet } from "@/test/fixtures/plugins";
+
+const component = () => null;
+const registration = {
+  id: "native",
+  providerId: "acp-chatgpt-web",
+  surface: "assistant-message" as const,
+  component,
+};
+afterEach(resetPluginSlotStoreForTest);
+
+describe("provider scoped visual rendering", () => {
+  it("validates provider, surface, component and duplicate scope at the same collector used by plugins", () => {
+    const collect = (extra: object) =>
+      collectPluginAppRegistrations({
+        __bbPluginApp: true,
+        setup(app) {
+          app.slots.experimental_providerRenderer({
+            ...registration,
+            ...extra,
+          });
+        },
+      });
+    expect(collect({}).providerRenderers).toEqual([registration]);
+    expect(() => collect({ providerId: "*" })).toThrow(/providerId/);
+    expect(() => collect({ surface: "approval" })).toThrow(/surface/);
+    expect(() => collect({ component: false })).toThrow(/component/);
+    expect(() =>
+      collectPluginAppRegistrations({
+        __bbPluginApp: true,
+        setup(app) {
+          app.slots.experimental_providerRenderer(registration);
+          app.slots.experimental_providerRenderer({
+            ...registration,
+            id: "duplicate",
+          });
+        },
+      }),
+    ).toThrow(/duplicate/);
+  });
+
+  it("does not target another provider, unknown context, user messages, or other surfaces", () => {
+    setPluginSlotRegistrations(
+      "visual",
+      makePluginRegistrationSet({ providerRenderers: [registration] }),
+    );
+    const slots = getPluginSlotSnapshot().providerRenderers;
+    expect(
+      resolveProviderRenderer(slots, "acp-chatgpt-web", "assistant-message")
+        ?.id,
+    ).toBe("native");
+    expect(
+      resolveProviderRenderer(slots, "codex", "assistant-message"),
+    ).toBeNull();
+    expect(
+      resolveProviderRenderer(slots, null, "assistant-message"),
+    ).toBeNull();
+    expect(
+      resolveProviderRenderer(slots, "acp-chatgpt-web", "tool-header"),
+    ).toBeNull();
+  });
+
+  it("fails closed on competing plugins and restores core on unload", () => {
+    const set = makePluginRegistrationSet({
+      providerRenderers: [registration],
+    });
+    setPluginSlotRegistrations("first", set);
+    setPluginSlotRegistrations("second", set);
+    expect(
+      resolveProviderRenderer(
+        getPluginSlotSnapshot().providerRenderers,
+        "acp-chatgpt-web",
+        "assistant-message",
+      ),
+    ).toBeNull();
+    resetPluginSlotStoreForTest();
+    expect(
+      resolveProviderRenderer(
+        getPluginSlotSnapshot().providerRenderers,
+        "acp-chatgpt-web",
+        "assistant-message",
+      ),
+    ).toBeNull();
+  });
+});
