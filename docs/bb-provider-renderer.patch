+// @vitest-environment jsdom
+import { useEffect, useState } from "react";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type {
+  ExperimentalProviderRendererContent,
+  ExperimentalProviderRendererProps,
+} from "@get-bb/plugin-sdk";
+import { ProviderContentRenderer } from "./ProviderContentRenderer";
+import { ProviderToolHeader } from "./ProviderToolHeader";
+import { ExpandableTimelineRow } from "./ExpandableTimelineRow";
+import { ThreadProviderContext } from "../thread-provider-context";
+import { resetAllCrashedPluginSlotsForTest } from "../../plugin/PluginSlotMount";
+import {
+  resetPluginSlotStoreForTest,
+  setPluginSlotRegistrations,
+} from "@/lib/plugin-slots";
+import { makePluginRegistrationSet } from "@/test/fixtures/plugins";
+import { toolRow, approvalRow } from "@/test/fixtures/thread-timeline-rows";
+import { buildTimelineRowTitle } from "@bb/thread-view";
+
+const message = {
+  id: "message",
+  threadId: "thread",
+  turnId: "turn",
+  projectId: null,
+};
+const mounts = vi.fn();
+function Renderer({ content, Original }: ExperimentalProviderRendererProps) {
+  const [count, setCount] = useState(0);
+  useEffect(() => {
+    mounts();
+  }, []);
+  return (
+    <section>
+      <button onClick={() => setCount(count + 1)}>local {count}</button>
+      <span data-testid="snapshot">{JSON.stringify(content)}</span>
+      <Original />
+    </section>
+  );
+}
+function OriginalChild({ text }: { text: string }) {
+  const [count, setCount] = useState(0);
+  return (
+    <button onClick={() => setCount(count + 1)}>
+      {text} {count}
+    </button>
+  );
+}
+function view(
+  text: string,
+  streaming: boolean,
+  providerId = "acp-chatgpt-web",
+) {
+  const content: ExperimentalProviderRendererContent = {
+    surface: "assistant-message",
+    message,
+    text,
+    streaming,
+  };
+  return (
+    <ThreadProviderContext.Provider value={{ providerId, pluginId: null }}>
+      <ProviderContentRenderer content={content}>
+        <OriginalChild text={text} />
+      </ProviderContentRenderer>
+    </ThreadProviderContext.Provider>
+  );
+}
+function install(
+  component = Renderer,
+  surface:
+    | "assistant-message"
+    | "tool-header"
+    | "tool-group-header" = "assistant-message",
+) {
+  setPluginSlotRegistrations(
+    "visual",
+    makePluginRegistrationSet({
+      providerRenderers: [
+        { id: "native", providerId: "acp-chatgpt-web", surface, component },
+      ],
+    }),
+  );
+}
+afterEach(() => {
+  cleanup();
+  resetPluginSlotStoreForTest();
+  resetAllCrashedPluginSlotsForTest();
+  vi.restoreAllMocks();
+  mounts.mockClear();
+});
+
+describe("provider renderer identity and fallback", () => {
+  it("retains plugin and Original state through snapshots, replacements and interrupted completion", () => {
+    install();
+    const v = render(view("draft", true));
+    fireEvent.click(screen.getByText("local 0"));
+    fireEvent.click(screen.getByText("draft 0"));
+    v.rerender(view("replaced", true));
+    expect(screen.getByText("local 1")).toBeDefined();
+    expect(screen.getByText("replaced 1")).toBeDefined();
+    v.rerender(view("interrupted", false));
+    expect(screen.getByText("interrupted 1")).toBeDefined();
+    expect(mounts).toHaveBeenCalledTimes(1);
+    expect(screen.getByTestId("snapshot").textContent).toContain(
+      '"streaming":false',
+    );
+  });
+  it("delegates on absent or mismatched provider and on a throwing renderer, then recovers on a new snapshot", () => {
+    install();
+    render(view("other", false, "codex"));
+    expect(screen.getByText("other 0")).toBeDefined();
+    expect(screen.queryByTestId("snapshot")).toBeNull();
+    cleanup();
+    resetPluginSlotStoreForTest();
+    function Broken(props: ExperimentalProviderRendererProps) {
+      if (
+        props.content.surface === "assistant-message" &&
+        props.content.text === "broken"
+      )
+        throw new Error("bad renderer");
+      return <props.Original />;
+    }
+    install(Broken);
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    const w = render(view("broken", true));
+    expect(screen.getByText("broken 0")).toBeDefined();
+    w.rerender(view("recovered", false));
+    expect(screen.getByText("recovered 0")).toBeDefined();
+  });
+  it("leaves tool disclosure keyboard interaction and the body owned by core", () => {
+    function Header({ content }: ExperimentalProviderRendererProps) {
+      return <span>Native {content.surface}</span>;
+    }
+    install(Header, "tool-header");
+    const row = toolRow({
+      id: "tool",
+      threadId: "thread",
+      toolName: "example",
+    });
