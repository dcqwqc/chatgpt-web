new file mode 100644
index 0000000..c9efeaf
--- /dev/null
+++ b/apps/app/src/components/thread/timeline/ProviderToolHeader.tsx
@@ -0,0 +1,43 @@
+import type { ReactNode } from "react";
+import type { ThreadTimelineViewRow } from "@bb/thread-view";
+import { ProviderContentRenderer } from "./ProviderContentRenderer.js";
+
+export function ProviderToolHeader({
+  row,
+  title,
+  children,
+}: {
+  row: ThreadTimelineViewRow;
+  title: string;
+  children: ReactNode;
+}) {
+  if (
+    row.kind !== "work" &&
+    row.kind !== "bundle-summary" &&
+    row.kind !== "step-summary"
+  )
+    return children;
+  const surface =
+    row.kind === "work" && row.workKind === "tool"
+      ? "tool-header"
+      : (row.kind === "bundle-summary" || row.kind === "step-summary") &&
+          row.children.length > 0 &&
+          row.children.every(
+            (child) => child.kind === "work" && child.workKind === "tool",
+          )
+        ? "tool-group-header"
+        : null;
+  if (surface === null) return children;
+  return (
+    <ProviderContentRenderer
+      content={{
+        surface,
+        row: { id: row.id, threadId: row.threadId, turnId: row.turnId },
+        title,
+        status: row.status,
+      }}
+    >
+      {children}
+    </ProviderContentRenderer>
+  );
+}
