@@ -0,0 +1,14 @@
+import type { ExperimentalProviderRendererContent } from "@get-bb/plugin-sdk";
+import type { ExperimentalProviderRendererSlot } from "./plugin-slots";
+
+export function resolveProviderRenderer(
+  slots: readonly ExperimentalProviderRendererSlot[],
+  providerId: string | null,
+  surface: ExperimentalProviderRendererContent["surface"],
+): ExperimentalProviderRendererSlot | null {
+  if (providerId === null) return null;
+  const matches = slots.filter(
+    (slot) => slot.providerId === providerId && slot.surface === surface,
+  );
+  return matches.length === 1 ? matches[0]! : null;
+}
diff --git a/docs/api_to_audit.md b/docs/api_to_audit.md
index 22921d2..1ebecba 100644
--- a/docs/api_to_audit.md
+++ b/docs/api_to_audit.md
@@ -3914,3 +3914,27 @@ precedence, bounded discovery failure, and module-ABI preservation after Node
 replacement. Settle the shared process-local instance lifecycle across SDK
 bundle versions and whether `bundledNpmCli` belongs on the public surface before
 removing the prefix.
+
+
+## experimental_providerRenderer
+
+Registration opts into one exact provider ID and one assistant-message, tool-header,
+or tool-group-header surface. No wildcard, user-message, approval, or permission
+surface exists. The host renders through ProviderContentRenderer in its normal
+ConversationMessageContent and ThreadTimelineRows paths, including embedded chats.
+A conflicting registration restores core. Disabled/unloaded plugins disappear
+through the existing registration lifecycle. Exceptions restore Original and retry
+on changed snapshots. Content is current state, never an append command. Stable
+message/turn/row identity and a context-backed Original preserve React state across
+updates. Core retains message selection, actions, attachments, code-fence context,
+expand/collapse controls, authorization, and all mixed and non-tool summary headers.
+
+Stabilization requires tests for no-registration/other-provider behavior, malformed
+scope, collisions, unload, crash/recovery, Original state, streaming replacement and
+interruption, nested provider contexts, tool disclosure keyboard use, and a visual
+matrix. Typography plugins may style only their own provider-renderer root. This API
+adds no message mutation or permission callback and no server/daemon wire fields.
+Header replacement changes only visual summary content, not group membership or row
+ordering. Full timeline/group restructuring and mutable ACP messages remain outside
+this extension's scope. Only explicit provider snapshots are exposed, never raw
+permission objects or internal timeline model references.
