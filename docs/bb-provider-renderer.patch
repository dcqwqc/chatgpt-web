+import { setPluginSlotRegistrations } from "../../src/lib/plugin-slots";
+import { makePluginRegistrationSet } from "../../src/test/fixtures/plugins";
+import {
+  conversationRow,
+  toolRow,
+} from "../../src/test/fixtures/thread-timeline-rows";
+import "@bb/shared-ui/icon-extended";
+import "../../src/app.css";
+import "./style.css";
+
+const parameters = new URLSearchParams(location.search);
+document.documentElement.classList.toggle(
+  "dark",
+  parameters.get("theme") === "dark",
+);
+const message =
+  "## Results\n\nI inspected the current thread and service status.\n\n**Implemented and verified:** The same content renders through a provider-scoped host extension.\n\n```python\nprint('Readiness verified')\n```\n\n### What remains\n\n- Matched native capture\n- Independent exact comparison";
+function Renderer({ content, Original }: ExperimentalProviderRendererProps) {
+  return content.surface === "assistant-message" ? (
+    <div className="provider-demo-prose">
+      <Original />
+    </div>
+  ) : (
+    <span className="provider-demo-tool">
+      Tool activity · <Original />
+    </span>
+  );
+}
+if (parameters.get("enabled") === "1")
+  setPluginSlotRegistrations(
+    "qa-provider-renderer",
+    makePluginRegistrationSet({
+      providerRenderers: (
+        ["assistant-message", "tool-header", "tool-group-header"] as const
+      ).map((surface) => ({
+        id: surface,
+        providerId: "acp-chatgpt-web",
+        surface,
+        component: Renderer,
+      })),
+    }),
+  );
+function Stage({ providerId }: { providerId: string }) {
+  const [rows] = useState(() => [
+    toolRow({
+      id: "tool-one",
+      threadId: "qa-thread",
+      turnId: "qa-turn",
+      toolName: "Inspect current thread",
+      toolArgs: { scope: "fixture" },
+      output: "Verified local fixture",
+    }),
+    toolRow({
+      id: "tool-two",
+      threadId: "qa-thread",
+      turnId: "qa-turn",
+      toolName: "Read service status",
+      toolArgs: { scope: "fixture" },
+      output: "No production request made",
+    }),
+    conversationRow({
+      id: "same-message",
+      threadId: "qa-thread",
+      turnId: "qa-turn",
+      role: "assistant",
+      text: message,
+    }),
+  ]);
+  return (
+    <ThreadProviderContext.Provider value={{ providerId, pluginId: null }}>
+      <section data-provider={providerId}>
+        <h1>{providerId}</h1>
+        <ThreadTimelineRows
+          threadId="qa-thread"
+          threadRuntimeDisplayStatus="idle"
+          timelineRows={rows}
+          workspaceRootPath={undefined}
+        />
+      </section>
+    </ThreadProviderContext.Provider>
+  );
+}
+createRoot(document.getElementById("root")!).render(
+  <QueryClientProvider
+    client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}
+  >
+    <MemoryRouter>
+      <RouteNavigationProvider>
+        <ThreadTitleMentionResourcesProvider
+          sectionNamesById={new Map()}
+          projectNamesById={new Map()}
+          threadById={new Map()}
+        >
+          <main>
+            <p>
+              BB source fixture · not deployed · not a native ChatGPT capture
+            </p>
+            <Stage providerId="acp-chatgpt-web" />
+            <Stage providerId="codex" />
+          </main>
+        </ThreadTitleMentionResourcesProvider>
+      </RouteNavigationProvider>
+    </MemoryRouter>
+  </QueryClientProvider>,
+);
